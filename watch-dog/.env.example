# GPT-DOUG-LLLM WATCH DOG
# OSAIO event mode is the practical path for NKCCNUR/Osaio cameras that do not expose RTSP/ONVIF.
CAMERA_SOURCE=osaio
CAMERA_NAME=Living Room

# OSAIO cloud bridge.
# IMPORTANT: use a SECOND Osaio account and share the Living Room camera to it so the bridge
# does not log the primary phone app out. Keep credentials only in your local .env file.
OSAIO_EMAIL=
OSAIO_PASSWORD=
OSAIO_SECRET=
OSAIO_DEVICE_NAME=Living Room
OSAIO_UUID=
OSAIO_POLL_MS=2000
OSAIO_TIMEZONE=America/New_York
OSAIO_ZONE=-4

# Advanced: instead of email/password login, supply an existing authenticated session.
OSAIO_BASE_URL=
OSAIO_UID=
OSAIO_API_TOKEN=
OSAIO_PHONE_CODE=

# RTSP fallback for other cameras.
# PRIVACY: only explicit local/private RTSP/RTSPS addresses are accepted.
# Public CCTV and arbitrary internet camera URLs are blocked in code.
CAMERA_URL=
FFMPEG_PATH=ffmpeg
FRAME_FPS=2
FRAME_WIDTH=640

# Dog detection / suspected bathroom-event logic.
DOG_CONFIDENCE=0.55
EVENT_THRESHOLD=0.72
EVENT_HOLD_MS=3000
ALERT_COOLDOWN_MS=60000
FLOOR_ZONE=0.18,0.40,0.98,1

# Immediate alert path.
ALERT_MODE=macos
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=home/living-room/dog-poop-alarm
MQTT_USERNAME=
MQTT_PASSWORD=

# ZYRA GeoVision -> Palantir-ready pipeline.
# ZYRA receives the event automatically, but Foundry writes remain pending human approval.
ZYRA_PIPELINE_URL=http://127.0.0.1:5050/api/va3lm/geovision/watch-dog/events
ZYRA_PIPELINE_TOKEN=

# Local control API.
HOST=127.0.0.1
PORT=8787
LOG_FRAMES=true
