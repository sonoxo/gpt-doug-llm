# GPT-DOUG-LLLM WATCH DOG
# OSAIO event mode is the practical path for NKCCNUR/Osaio cameras that do not expose RTSP/ONVIF.
CAMERA_SOURCE=osaio
CAMERA_NAME=Living Room

# OSAIO cloud bridge.
# IMPORTANT: use a SECOND Osaio account and share the Living Room camera to it so the bridge
# does not log the primary phone app out. Keep credentials only in your local .env file.
OSAIO_EMAIL=
OSAIO_PASSWORD=
# Required HMAC signing value for the Osaio client. Do not commit this secret.
OSAIO_SECRET=
OSAIO_DEVICE_NAME=Living Room
OSAIO_UUID=
OSAIO_POLL_MS=2000
OSAIO_TIMEZONE=America/New_York
OSAIO_ZONE=-4

# Advanced: instead of email/password login, supply an existing authenticated session.
OSAIO_BASE_URL=
OSAIO_UID=
OSAIO_API_TOKEN=
OSAIO_PHONE_CODE=

# RTSP fallback for other cameras.
CAMERA_URL=
FFMPEG_PATH=ffmpeg
FRAME_FPS=2
FRAME_WIDTH=640

# Dog detection / suspected bathroom-event logic.
DOG_CONFIDENCE=0.55
EVENT_THRESHOLD=0.72
EVENT_HOLD_MS=3000
ALERT_COOLDOWN_MS=60000
# Tuned starting rectangle for the supplied Living Room camera framing.
FLOOR_ZONE=0.18,0.40,0.98,1

# Alert mode: macos | console | webhook | mqtt
# macos makes the Mac speak immediately and also emits a terminal bell.
ALERT_MODE=macos

# webhook mode
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# mqtt mode
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=home/living-room/dog-poop-alarm
MQTT_USERNAME=
MQTT_PASSWORD=

# Local control API. Keep on loopback unless you intentionally secure/expose it.
HOST=127.0.0.1
PORT=8787
LOG_FRAMES=true
