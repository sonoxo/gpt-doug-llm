# Camera stream. Use a local RTSP URL when the C360/app exposes one.
CAMERA_URL=rtsp://USER:PASSWORD@192.168.1.50:554/stream1
CAMERA_NAME=living-room
FFMPEG_PATH=ffmpeg
FRAME_FPS=2
FRAME_WIDTH=640

# Dog detection / bathroom-event logic
DOG_CONFIDENCE=0.55
EVENT_THRESHOLD=0.72
EVENT_HOLD_MS=3000
ALERT_COOLDOWN_MS=60000
# Normalized x1,y1,x2,y2. Default = lower 70% of frame.
FLOOR_ZONE=0,0.30,1,1

# Alert mode: console | webhook | mqtt
ALERT_MODE=console

# webhook mode
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# mqtt mode
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=home/living-room/dog-poop-alarm
MQTT_USERNAME=
MQTT_PASSWORD=

# Local control API (bind loopback unless you intentionally expose it)
HOST=127.0.0.1
PORT=8787
