{
  "name": "gpt-doug-lllm-watch-dog",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first IoT dog bathroom-event watchdog for Osaio/RTSP cameras and siren/webhook/MQTT alerts.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jpeg-js": "^0.4.4",
    "mqtt": "^5.10.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
