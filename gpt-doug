#!/usr/bin/env python3
"""Minimal local terminal client for the GPT Doug Ollama model."""

import json
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
import getpass

from zyra import Zyra
from foundry_guard import FoundrySecuritySink
from compliance import ComplianceGate, UserContext
from auth_gate import ThreeFactorGate, VerifiedIdentity
from dev_terminal import DevTerminal
from pathlib import Path

MODEL = "gpt-doug"
API = "http://127.0.0.1:11434/api/chat"
GREEN = "\033[38;5;154m"
CYAN = "\033[38;5;51m"
RESET = "\033[0m"

BANNER = r"""
   ██████╗ ██████╗ ████████╗    ██████╗  ██████╗ ██╗   ██╗ ██████╗
  ██╔════╝ ██╔══██╗╚══██╔══╝    ██╔══██╗██╔═══██╗██║   ██║██╔════╝
  ██║  ███╗██████╔╝   ██║       ██║  ██║██║   ██║██║   ██║██║  ███╗
  ╚██████╔╝██║        ██║       ██████╔╝╚██████╔╝╚██████╔╝╚██████╔╝
   ╚═════╝ ╚═╝        ╚═╝       ╚═════╝  ╚═════╝  ╚═════╝  ╚═════╝
"""


def ensure_runtime():
    if not shutil.which("ollama"):
        raise SystemExit("Ollama is not installed. Visit https://ollama.com")
    try:
        urllib.request.urlopen("http://127.0.0.1:11434", timeout=1)
    except Exception:
        subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def chat(messages):
    body = json.dumps({"model": MODEL, "messages": messages, "stream": True}).encode()
    request = urllib.request.Request(API, body, {"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=300) as response:
            answer = ""
            for line in response:
                event = json.loads(line)
                token = event.get("message", {}).get("content", "")
                answer += token
                # Buffer the answer so Zyra can inspect it before display.
            return answer
    except urllib.error.URLError as error:
        print(f"Unable to reach Ollama: {error}")
        return ""


def main():
    ensure_runtime()
    try:
        identity = VerifiedIdentity.from_environment()
    except ValueError as error:
        raise SystemExit(f"3FA ACCESS DENIED: {error}")
    auth = ThreeFactorGate(identity)
    if not auth.authenticate(getpass.getpass("Google Authenticator code: ").strip()):
        raise SystemExit("3FA ACCESS DENIED: invalid authenticator code")
    try:
        foundry_sink = FoundrySecuritySink.from_environment()
    except ValueError as error:
        raise SystemExit(f"Zyra Foundry configuration rejected: {error}")
    zyra = Zyra(event_sink=foundry_sink)
    user_context = UserContext.from_environment()
    compliance = ComplianceGate(user_context)
    dev_terminal = DevTerminal(auth, user_context, Path(__file__).parent, zyra.audit_path)
    print(CYAN + BANNER + RESET)
    print(GREEN + "EUREKA // LOCAL SYSTEM ONLINE" + RESET)
    print(CYAN + "ZYRA // CYBER WATCHDOG ACTIVE" + RESET)
    print(CYAN + ("FOUNDRY // GOVERNANCE BRIDGE ACTIVE" if foundry_sink else "FOUNDRY // BRIDGE DISABLED") + RESET)
    print(CYAN + "COMPLIANCE // " + compliance.status() + RESET)
    print(CYAN + "3FA // " + auth.summary() + RESET)
    history = []
    while True:
        try:
            prompt = input("\nyou > ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nSignal closed.")
            return
        if not prompt:
            continue
        if prompt == "/quit":
            return
        if prompt == "/clear":
            history.clear()
            print("Memory cleared.")
            continue
        if prompt == "/help":
            print("/help  /clear  /mission  /zyra  /compliance  /eureka 369  /quit")
            continue
        if prompt == "/mission":
            print("Build useful things. Protect privacy. Keep humans in command.")
            continue
        if prompt == "/zyra":
            print(zyra.status())
            continue
        if prompt == "/compliance":
            print(compliance.status())
            continue
        if prompt.lower() in {"eureka 369", "/eureka 369"}:
            zyra.inspect("EUREKA 369 developer elevation request", "control")
            fresh_code = getpass.getpass("Fresh Google Authenticator code: ").strip()
            if not dev_terminal.elevate(fresh_code):
                print("EUREKA 369 DENIED // authorized developer/admin role and fresh 3FA required")
                continue
            dev_terminal.run()
            continue
        compliance_decision = compliance.inspect(prompt)
        if not compliance_decision.allowed:
            print("COMPLIANCE BLOCKED // " + compliance_decision.reason)
            continue
        if compliance_decision.requires_review:
            review = input("HUMAN REVIEW REQUIRED // approve this request? [y/N] ").strip().lower()
            if review not in {"y", "yes"}:
                print("Request cancelled.")
                continue
        verdict = zyra.inspect(prompt, "input")
        if not verdict.allowed:
            print("ZYRA BLOCKED // " + "; ".join(verdict.reasons))
            continue
        if verdict.requires_approval:
            answer = input("ZYRA APPROVAL REQUIRED // continue? [y/N] ").strip().lower()
            if answer not in {"y", "yes"}:
                print("Action cancelled.")
                continue
        history.append({"role": "user", "content": verdict.text})
        print(GREEN + "doug > " + RESET, end="")
        answer = chat(history)
        if answer:
            output_verdict = zyra.inspect(answer, "output")
            print(output_verdict.text)
            if output_verdict.text != answer: print("ZYRA NOTICE // sensitive output was redacted")
            history.append({"role": "assistant", "content": output_verdict.text})


if __name__ == "__main__":
    main()
