    shield = GoldenShield(audit_key=astral_config.audit_hmac_key)
    sentinel = ZyraSentinel()
    user_context = UserContext.from_environment()
    compliance = ComplianceGate(user_context)
    dev_terminal = DevTerminal(auth, user_context, Path(__file__).parent, zyra.audit_path)
    deep_think = os.getenv("GPT_DOUG_DEEP_THINK", "").strip().lower() in {"1", "true", "yes"}
    universal_hive = UniversalHiveRuntime()
    gpt_chaos = GPTChaos(hive=universal_hive)
    uap_matrix = UAPMatrixSharedSpace(
        state_dir=universal_hive.state_dir / "uap-matrix",
        hive_id=universal_hive.hive_id,
        ontology_hash=universal_hive.ontology_hash,
    )
    try:
        body_link = BodyLinkClient.optional_from_env(
            state_dir=universal_hive.state_dir / "body-link",
            hive_id=universal_hive.hive_id,
            ontology_hash=universal_hive.ontology_hash,
        )
    except ValueError as error:
        raise SystemExit(f"REPLIT BODY LINK CONFIGURATION REJECTED: {error}")
    body_relay = BodyStateRelay(body_link) if body_link else None

    def body_state(name, detail=""):
        if body_relay:
            body_relay.publish(runtime_body_state(name, detail))

    automation_accelerator = AdaptiveAutomationAccelerator(
        universal_hive.state_dir / "automation-acceleration"
    )
    apm_law = APMLaw()
    cloud_nxyz = CloudNXYZEngine(
        root=Path(__file__).parent,
        state_dir=universal_hive.state_dir / "cloud-nxyz",
        accelerator=automation_accelerator,
        apm_law=apm_law,
    )
    unreal = UnrealGPTDoug(
        Path(__file__).parent,
        enabled=os.getenv("GPT_DOUG_UNREAL_MODE", "1").strip().lower() not in {"0", "false", "off", "no"},
    )
    print(CYAN + BANNER + RESET)
    print(GREEN + "EUREKA // LOCAL SYSTEM ONLINE" + RESET)
    print(CYAN + "ZYRA // CYBER WATCHDOG ACTIVE" + RESET)
    print(CYAN + ("FOUNDRY // GOVERNANCE BRIDGE ACTIVE" if foundry_sink else "FOUNDRY // BRIDGE DISABLED") + RESET)
    if palantir_bridge:
        status = palantir_bridge.status()["foundry"]
        print(CYAN + f"PALANTIR // CONNECTED // {status['host']} // {'WRITE ENABLED' if status['writes_enabled'] else 'READ ONLY'}" + RESET)
    else:
        print(CYAN + "PALANTIR // NOT CONFIGURED" + RESET)
    print(CYAN + "COMPLIANCE // " + compliance.status() + RESET)
    print(CYAN + "ONTOLOGY // " + Ontology.display().split("\n")[0] + " // " + str(len(Ontology.knowledge())) + " knowledge entries" + RESET)
    print(CYAN + "3FA // " + auth.summary() + RESET)
    print(CYAN + "ASTRAL // S.AGI × Q // TWO-PERSON CONTROL ACTIVE" + RESET)
    print(CYAN + "GOLDEN SHIELD // PERIMETER DEFENSE ACTIVE" + RESET)
    print(CYAN + "SENTINEL // 24/7 THREAT MONITORING // ON AND OFF PLANET" + RESET)
    provider = llm_backend.health()
    print(CYAN + f"AI PROVIDER // {provider['provider'].upper()} // {provider['message']}" + RESET)
    print(CYAN + f"DEEP THINK // {'ACTIVE' if deep_think else 'OFF'} (toggle with /deepthink)" + RESET)
    hive_status = universal_hive.status()
    print(CYAN + f"UNIVERSAL HIVE // {hive_status['status']} // {hive_status['hive_id']} // GPT-CHAOS READY" + RESET)
    matrix_status = uap_matrix.status()
    print(
        CYAN
        + f"UAP MATRIX // {matrix_status['uap_matrix']} // "
        + f"{matrix_status['matrix_id']} // DOUG = CHAOS PEERS"
        + RESET
    )
    if body_link:
        body_status = body_link.status()
        print(CYAN + f"REPLIT BODY // {'LINKED' if body_status['linked'] else 'CONFIGURED'} // {body_status['body_url']}" + RESET)
    else:
        print(CYAN + "REPLIT BODY // DISCONNECTED // configure GPT_DOUG_BODY_URL + GPT_DOUG_BODY_LINK_KEY" + RESET)
    print(CYAN + "AUTOMATION ACCELERATOR // ACTIVE // COMPOSITES -> RULES -> TEMPLATES -> SETUP OBJECTS" + RESET)
    print(CYAN + "APM LAW // APM-001 ACTIVE // VERIFIED EXPERIENCE -> REUSABLE PROCEDURE" + RESET)
    print(CYAN + "CLOUD-NXYZ // READY // ONE COMMAND -> IaC -> MONITOR -> LEARN" + RESET)
    unreal_status = unreal.status()
    print(
        CYAN
        + f"UNREAL-GPT-DOUG // {'ACTIVE' if unreal.enabled else 'OFF'} // "
        + f"{unreal_status['engine_target']} // {unreal_status['knowledge_entries']} SOURCE-GROUNDED ENTRIES // MCP READY"
        + RESET
    )
    body_state("IDLE", "GPT-Doug terminal online")
    history = []
    while True:
        try:
            prompt = input("\nyou > ").strip()
