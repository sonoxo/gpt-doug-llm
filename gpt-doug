#!/usr/bin/env python3
"""Secure terminal client for GPT Doug's configured AI provider."""

import os
import sys
import getpass

from agents import llm_backend

from zyra import Zyra
from golden_shield import GoldenShield
from golden_shield import ZyraSentinel
from foundry_guard import FoundrySecuritySink
from palantir_bridge import DougPalantirBridge
from palantir_foundry import FoundryError
from palantir_terminal import handle_palantir_command
from compliance import ComplianceGate, UserContext
from auth_gate import ThreeFactorGate, VerifiedIdentity
from dev_terminal import DevTerminal
from pathlib import Path
from astral import AstralConfig, AstralGate
from secret_store import SecretStore
from ontology import Ontology

MODEL = llm_backend.DEFAULT_MODEL
GREEN = "\033[38;5;154m"
CYAN = "\033[38;5;51m"
RESET = "\033[0m"

BANNER = r"""
   ██████╗ ██████╗ ████████╗    ██████╗  ██████╗ ██╗   ██╗ ██████╗
  ██╔════╝ ██╔══██╗╚══██╔══╝    ██╔══██╗██╔═══██╗██║   ██║██╔════╝
  ██║  ███╗██████╔╝   ██║       ██║  ██║██║   ██║██║   ██║██║  ███╗
  ╚██████╔╝██║        ██║       ██████╔╝╚██████╔╝╚██████╔╝╚██████╔╝
   ╚═════╝ ╚═╝        ╚═╝       ╚═════╝  ╚═════╝  ╚═════╝  ╚═════╝
"""


def chat(messages):
    try:
        answer = ""
        for event in llm_backend.chat_stream(messages, MODEL, {}):
            answer += event.get("message", {}).get("content", "")
        return answer
    except Exception as error:
        print(f"Unable to reach the selected AI provider: {error}")
        return ""


DEEP_THINK_CRITIQUE_PROMPT = (
    "Review your previous answer for factual errors, gaps, or unstated assumptions. "
    "Then give a corrected, final answer only — no meta-commentary about the review itself."
)


def deep_think_chat(history, zyra):
    """Draft -> self-critique -> revise. Every intermediate pass is still
    audited through Zyra, same as a normal single-pass reply — depth of
    reasoning never reduces the number of safety checks."""
    draft = chat(history)
    if not draft:
        return "", []
    passes = [zyra.inspect(draft, "output")]
    if not passes[0].allowed:
        return passes[0].text, passes

    critique_history = history + [
        {"role": "assistant", "content": passes[0].text},
        {"role": "user", "content": DEEP_THINK_CRITIQUE_PROMPT},
    ]
    revised = chat(critique_history)
    if not revised:
        return passes[0].text, passes
    passes.append(zyra.inspect(revised, "output"))
    return passes[-1].text, passes


def main():
    try:
        developer_account = os.getenv("GPT_DOUG_VERIFIED_BUSINESS_EMAIL", "").strip()
        officer_account = os.getenv("ASTRAL_SECURITY_OFFICER_EMAIL", "").strip()
        os.environ["GPT_DOUG_TOTP_SECRET"] = SecretStore.get("developer_totp", developer_account)
        os.environ["ASTRAL_SECURITY_OFFICER_TOTP_SECRET"] = SecretStore.get("officer_totp", officer_account)
        os.environ["ASTRAL_AUDIT_HMAC_KEY"] = SecretStore.get("audit_hmac", developer_account)
        identity = VerifiedIdentity.from_environment()
    except ValueError as error:
        raise SystemExit(f"3FA ACCESS DENIED: {error}")
    auth = ThreeFactorGate(identity)
    if not auth.authenticate(getpass.getpass("Google Authenticator code: ").strip()):
        raise SystemExit("3FA ACCESS DENIED: invalid authenticator code")
    try:
        astral_config = AstralConfig.from_environment(identity)
    except ValueError as error:
        raise SystemExit(f"ASTRAL FAIL-CLOSED: {error}")
    finally:
        os.environ.pop("GPT_DOUG_TOTP_SECRET", None)
        os.environ.pop("ASTRAL_SECURITY_OFFICER_TOTP_SECRET", None)
        os.environ.pop("ASTRAL_AUDIT_HMAC_KEY", None)
    astral = AstralGate(astral_config, auth)
    try:
        foundry_sink = FoundrySecuritySink.from_environment()
    except ValueError as error:
        raise SystemExit(f"Zyra Foundry configuration rejected: {error}")
    try:
        palantir_bridge = DougPalantirBridge.from_environment()
    except FoundryError as error:
        raise SystemExit(f"Palantir Foundry configuration rejected: {error}")
    zyra = Zyra(event_sink=foundry_sink, audit_key=astral_config.audit_hmac_key)
    shield = GoldenShield(audit_key=astral_config.audit_hmac_key)
    sentinel = ZyraSentinel()
    user_context = UserContext.from_environment()
    compliance = ComplianceGate(user_context)
    dev_terminal = DevTerminal(auth, user_context, Path(__file__).parent, zyra.audit_path)
    deep_think = os.getenv("GPT_DOUG_DEEP_THINK", "").strip().lower() in {"1", "true", "yes"}
    print(CYAN + BANNER + RESET)
    print(GREEN + "EUREKA // LOCAL SYSTEM ONLINE" + RESET)
    print(CYAN + "ZYRA // CYBER WATCHDOG ACTIVE" + RESET)
    print(CYAN + ("FOUNDRY // GOVERNANCE BRIDGE ACTIVE" if foundry_sink else "FOUNDRY // BRIDGE DISABLED") + RESET)
    if palantir_bridge:
        status = palantir_bridge.status()["foundry"]
        print(CYAN + f"PALANTIR // CONNECTED // {status['host']} // {'WRITE ENABLED' if status['writes_enabled'] else 'READ ONLY'}" + RESET)
    else:
        print(CYAN + "PALANTIR // NOT CONFIGURED" + RESET)
    print(CYAN + "COMPLIANCE // " + compliance.status() + RESET)
    print(CYAN + "ONTOLOGY // " + Ontology.display().split("\n")[0] + " // " + str(len(Ontology.knowledge())) + " knowledge entries" + RESET)
    print(CYAN + "3FA // " + auth.summary() + RESET)
    print(CYAN + "ASTRAL // S.AGI × Q // TWO-PERSON CONTROL ACTIVE" + RESET)
    print(CYAN + "GOLDEN SHIELD // PERIMETER DEFENSE ACTIVE" + RESET)
    print(CYAN + "SENTINEL // 24/7 THREAT MONITORING // ON AND OFF PLANET" + RESET)
    provider = llm_backend.health()
    print(CYAN + f"AI PROVIDER // {provider['provider'].upper()} // {provider['message']}" + RESET)
    print(CYAN + f"DEEP THINK // {'ACTIVE' if deep_think else 'OFF'} (toggle with /deepthink)" + RESET)
    history = []
    while True:
        try:
            prompt = input("\nyou > ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nSignal closed.")
            return
        if not prompt:
            continue
        if prompt == "/quit":
            return
        if prompt == "/clear":
            history.clear()
            print("Memory cleared.")
            continue
        if prompt == "/help":
            print("/help  /clear  /mission  /zyra  /shield  /sentinel  /scan  /compliance  /ontology  /palantir  /deepthink  /eureka 369  /quit")
            continue
        if prompt == "/deepthink":
            deep_think = not deep_think
            print(f"DEEP THINK // {'ACTIVE' if deep_think else 'OFF'}")
            continue
        if prompt == "/mission":
            print("Build useful things. Protect privacy. Keep humans in command.")
            continue
        if prompt == "/zyra":
            print(zyra.status())
            continue
        if prompt == "/shield":
            print(shield.display())
            continue
        if prompt == "/sentinel":
            print(sentinel.display())
            continue
        if prompt == "/scan":
            print("SENTINEL // Running full sweep scan...")
            report = sentinel.full_sweep()
            print(sentinel.latest_findings_display())
            continue
        if prompt == "/sentinel start":
            sentinel.start_continuous()
            print("SENTINEL // 24/7 continuous monitoring started")
            continue
        if prompt == "/sentinel stop":
            sentinel.stop_continuous()
            print("SENTINEL // continuous monitoring stopped")
            continue
        if prompt == "/compliance":
            print(compliance.status())
            continue
        if prompt == "/ontology":
            print(Ontology.display())
            continue
        if prompt.startswith("/knowledge "):
            query = prompt[len("/knowledge "):]
            links = Ontology.task_knowledge("search", query, top_n=5)
            if not links:
                print("No matching knowledge entries found.")
            else:
                entries = {e["id"]: e for e in Ontology.knowledge()}
                for link in links:
                    entry = entries.get(link["to"][1])
                    if entry:
                        print(f"  - ({entry.get('attribution', '?')}) {entry.get('summary', '?')[:80]} [confidence={link['confidence']}]")
            continue
        if prompt == "/tasks":
            tasks = Ontology.tasks()
            if not tasks:
                print("No tasks in queue.")
            else:
                for t in tasks:
                    print(f"  [{t['status']}] {t['id']}: {t.get('prompt', '?')[:60]}")
            continue
        if prompt.startswith("/submit "):
            parts = prompt[len("/submit "):].split(" ", 1)
            if len(parts) < 2:
                print("Usage: /submit <task_id> <prompt>")
            else:
                task_id, task_prompt = parts[0], parts[1]
                verdict = zyra.inspect(task_prompt, "input")
                if not verdict.allowed:
                    print("ZYRA BLOCKED // " + "; ".join(verdict.reasons))
                else:
                    try:
                        result = Ontology.submit_task(task_id, verdict.text)
                        print(f"Task submitted: {result['task_id']} -> {result['path']}")
                    except Exception as e:
                        print(f"Submit failed: {e}")
            continue
        if prompt.startswith("/palantir"):
            palantir_result = handle_palantir_command(
                prompt,
                palantir_bridge,
                approve_write=lambda message: input(f"{message} [y/N] ").strip().lower() in {"y", "yes"},
            )
            if palantir_result.grounded_prompt:
                prompt = palantir_result.grounded_prompt
            elif palantir_result.handled:
                print(palantir_result.output)
                continue
        if prompt.lower() in {"eureka 369", "/eureka 369"}:
            zyra.inspect("EUREKA 369 developer elevation request", "control")
            fresh_code = getpass.getpass("Developer Google Authenticator code: ").strip()
            officer_code = getpass.getpass("Security officer Google Authenticator code: ").strip()
            if not dev_terminal.elevate(fresh_code) or not astral.authorize(fresh_code, officer_code):
                print("ASTRAL DENIED // developer role plus independent security-officer approval required")
                continue
            dev_terminal.run(session_seconds=astral_config.session_seconds, max_commands=astral_config.max_commands)
            continue
        compliance_decision = compliance.inspect(prompt)
        if not compliance_decision.allowed:
            print("COMPLIANCE BLOCKED // " + compliance_decision.reason)
            continue
        if compliance_decision.requires_review:
            review = input("HUMAN REVIEW REQUIRED // approve this request? [y/N] ").strip().lower()
            if review not in {"y", "yes"}:
                print("Request cancelled.")
                continue
        assessment = shield.inspect_inbound(prompt, "terminal")
        if assessment.action == "ELIMINATE":
            print("GOLDEN SHIELD // THREAT ELIMINATED // " + assessment.reason)
            continue
        if assessment.action == "BLOCK":
            print("GOLDEN SHIELD // BLOCKED // " + assessment.reason)
            continue
        if assessment.action == "QUARANTINE":
            if assessment.rate_limited:
                print("GOLDEN SHIELD // RATE LIMITED // " + assessment.reason)
                continue
            review = input("GOLDEN SHIELD // APPROVAL REQUIRED // continue? [y/N] ").strip().lower()
            if review not in {"y", "yes"}:
                print("Action cancelled.")
                continue
        verdict = assessment.zyra_verdict
        if not verdict:
            verdict = zyra.inspect(prompt, "input")
            if not verdict.allowed:
                print("ZYRA BLOCKED // " + "; ".join(verdict.reasons))
                continue
        history.append({"role": "user", "content": verdict.text})
        print(GREEN + ("doug (deep think) > " if deep_think else "doug > ") + RESET, end="")
        if deep_think:
            final_text, think_passes = deep_think_chat(history, zyra)
            out_assessment = shield.inspect_outbound(final_text, "model")
            if out_assessment.action == "BLOCK":
                print("GOLDEN SHIELD // OUTPUT BLOCKED // " + out_assessment.reason)
                continue
            safe_text = out_assessment.zyra_verdict.text if out_assessment.zyra_verdict else final_text
            print(safe_text)
            if len(think_passes) > 1 and think_passes[0].text != think_passes[-1].text:
                print("DEEP THINK // revised after self-critique")
            if final_text:
                history.append({"role": "assistant", "content": final_text})
        else:
            answer = chat(history)
            if answer:
                out_assessment = shield.inspect_outbound(answer, "model")
                if out_assessment.action == "BLOCK":
                    print("GOLDEN SHIELD // OUTPUT BLOCKED // " + out_assessment.reason)
                    continue
                safe_text = out_assessment.zyra_verdict.text if out_assessment.zyra_verdict else answer
                print(safe_text)
                if safe_text != answer:
                    print("GOLDEN SHIELD // output was sterilized")
                history.append({"role": "assistant", "content": safe_text})


if __name__ == "__main__":
    main()
