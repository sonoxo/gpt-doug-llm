        if prompt == "/sentinel":
            print(sentinel.display())
            continue
        if prompt == "/scan":
            print("SENTINEL // Running full sweep scan...")
            report = sentinel.full_sweep()
            print(sentinel.latest_findings_display())
            continue
        if prompt == "/sentinel start":
            sentinel.start_continuous()
            print("SENTINEL // 24/7 continuous monitoring started")
            continue
        if prompt == "/sentinel stop":
            sentinel.stop_continuous()
            print("SENTINEL // continuous monitoring stopped")
            continue
        if prompt == "/compliance":
            print(compliance.status())
            continue
        if prompt == "/ontology":
            print(Ontology.display())
            continue
        if prompt == "/hive":
            payload = gpt_chaos.status()
            payload["adaptive_automation"] = automation_accelerator.status()
            print(json.dumps(payload, indent=2, sort_keys=True))
            continue
        if prompt == "/matrix":
            print(json.dumps(uap_matrix.status(), indent=2, sort_keys=True))
            continue
        if prompt == "/matrix checkpoint":
            print(
                json.dumps(
                    uap_matrix.checkpoint("gpt-doug-terminal"),
                    indent=2,
                    sort_keys=True,
                )
            )
            continue
        if prompt.startswith("/matrix publish "):
            parts = prompt[len("/matrix publish "):].split(" ", 1)
            if len(parts) != 2:
                print("Usage: /matrix publish <channel> <message>")
                continue
            channel, message = parts
            try:
                event = uap_matrix.publish("GPT_DOUG", channel, message)
                print(json.dumps(event, indent=2, sort_keys=True))
            except ValueError as error:
                print(f"UAP MATRIX // REJECTED // {error}")
            continue
        if prompt.startswith("/matrix propose "):
            statement = prompt[len("/matrix propose "):].strip()
            if not statement:
                print("Usage: /matrix propose <statement>")
                continue
            decision = uap_matrix.propose("GPT_DOUG", statement)
            print(json.dumps(decision, indent=2, sort_keys=True))
            continue
        if prompt.startswith("/matrix vote "):
            parts = prompt[len("/matrix vote "):].split()
            if len(parts) != 2:
                print(
                    "Usage: /matrix vote <decision_id> "
                    "<SUPPORT|DISSENT|ABSTAIN>"
                )
                continue
            decision_id, choice = parts
            try:
                decision = uap_matrix.vote("GPT_DOUG", decision_id, choice)
                print(json.dumps(decision, indent=2, sort_keys=True))
            except (KeyError, ValueError) as error:
                print(f"UAP MATRIX // REJECTED // {error}")
            continue
        if prompt == "/body":
            if not body_link:
                print(json.dumps({"configured": False, "workspace_url": BodyLinkClient.WORKSPACE_URL}, indent=2))
            else:
                print(json.dumps(body_link.status(), indent=2, sort_keys=True))
            continue
        if prompt == "/body link":
            if not body_link:
                print("REPLIT BODY // NOT CONFIGURED // set GPT_DOUG_BODY_URL + GPT_DOUG_BODY_LINK_KEY")
            else:
                try:
                    print(json.dumps(body_link.link(), indent=2, sort_keys=True))
                except Exception as error:
                    print(f"REPLIT BODY // LINK FAILED // {error}")
            continue
        if prompt == "/body ping":
            if not body_link:
                print("REPLIT BODY // NOT CONFIGURED // set GPT_DOUG_BODY_URL + GPT_DOUG_BODY_LINK_KEY")
            else:
                try:
                    print(json.dumps(body_link.ping(), indent=2, sort_keys=True))
                except Exception as error:
                    print(f"REPLIT BODY // HEARTBEAT FAILED // {error}")
            continue
        if prompt == "/accelerator":
            print(json.dumps(automation_accelerator.status(), indent=2, sort_keys=True))
            continue
        if prompt == "/automation-template":
            print(json.dumps(automation_accelerator.template("hivemind"), indent=2, sort_keys=True))
            continue
        if prompt == "/apm-law":
            print(json.dumps(apm_law.status(), indent=2, sort_keys=True))
            continue
        if prompt == "/cloud-nxyz":
            print(json.dumps(cloud_nxyz.status(), indent=2, sort_keys=True))
            continue
        if prompt.startswith("/summon "):
            job = prompt[len("/summon "):].strip()
            if not job:
                print("Usage: /summon <job>")
                continue
            swarm = gpt_chaos.summon(job)
            print(json.dumps(swarm, indent=2, sort_keys=True))
            continue
        if prompt == "/unreal":
            print(json.dumps(unreal.status(), indent=2, sort_keys=True))
            continue
        if prompt == "/unreal on":
            unreal.enabled = True
            print("UNREAL-GPT-DOUG // ACTIVE // source-grounded UE 5.8 context injection enabled")
            continue
        if prompt == "/unreal off":
            unreal.enabled = False
            print("UNREAL-GPT-DOUG // OFF // knowledge remains installed but prompt injection is disabled")
            continue
        if prompt.startswith("/unreal search "):
            query = prompt[len("/unreal search "):].strip()
            if not query:
                print("Usage: /unreal search <query>")
            else:
                print(json.dumps(unreal.search(query, top_n=10), indent=2, sort_keys=True))
            continue
        if prompt == "/unreal sources":
            print(json.dumps(unreal.source_list(), indent=2, sort_keys=True))
            continue
        if prompt.startswith("/unreal sources "):
            query = prompt[len("/unreal sources "):].strip()
            print(json.dumps(unreal.source_list(query), indent=2, sort_keys=True))
            continue
        if prompt == "/unreal mcp":
            print(json.dumps(unreal.mcp_guide(), indent=2, sort_keys=True))
            continue
        if prompt.startswith("/knowledge "):
            query = prompt[len("/knowledge "):]
            links = Ontology.task_knowledge("search", query, top_n=5)
            if not links:
                print("No matching knowledge entries found.")
            else:
                entries = {e["id"]: e for e in Ontology.knowledge()}
                for link in links:
                    entry = entries.get(link["to"][1])
                    if entry:
                        print(f"  - ({entry.get('attribution', '?')}) {entry.get('summary', '?')[:80]} [confidence={link['confidence']}]")
            continue
        if prompt == "/tasks":
            tasks = Ontology.tasks()
            if not tasks:
                print("No tasks in queue.")
            else:
                for t in tasks:
                    print(f"  [{t['status']}] {t['id']}: {t.get('prompt', '?')[:60]}")
            continue
        if prompt.startswith("/submit "):
            parts = prompt[len("/submit "):].split(" ", 1)
            if len(parts) < 2:
                print("Usage: /submit <task_id> <prompt>")
            else:
                task_id, task_prompt = parts[0], parts[1]
                verdict = zyra.inspect(task_prompt, "input")
                if not verdict.allowed:
                    print("ZYRA BLOCKED // " + "; ".join(verdict.reasons))
                else:
                    try:
                        result = Ontology.submit_task(task_id, verdict.text)
                        print(f"Task submitted: {result['task_id']} -> {result['path']}")
                    except Exception as e:
                        print(f"Submit failed: {e}")
            continue
        if prompt.startswith("/palantir"):
            palantir_result = handle_palantir_command(
                prompt,
                palantir_bridge,
                approve_write=lambda message: input(f"{message} [y/N] ").strip().lower() in {"y", "yes"},
            )
            if palantir_result.grounded_prompt:
                prompt = palantir_result.grounded_prompt
            elif palantir_result.handled:
                print(palantir_result.output)
                continue
        if prompt.lower() in {"eureka 369", "/eureka 369"}:
            zyra.inspect("EUREKA 369 developer elevation request", "control")
            fresh_code = getpass.getpass("Developer Google Authenticator code: ").strip()
            officer_code = getpass.getpass("Security officer Google Authenticator code: ").strip()
            if not dev_terminal.elevate(fresh_code) or not astral.authorize(fresh_code, officer_code):
                print("ASTRAL DENIED // developer role plus independent security-officer approval required")
                continue
            dev_terminal.run(session_seconds=astral_config.session_seconds, max_commands=astral_config.max_commands)
            continue
        body_state("THINK", prompt)
        compliance_decision = compliance.inspect(prompt)
        if not compliance_decision.allowed:
            print("COMPLIANCE BLOCKED // " + compliance_decision.reason)
            continue
        if compliance_decision.requires_review:
            review = input("HUMAN REVIEW REQUIRED // approve this request? [y/N] ").strip().lower()
            if review not in {"y", "yes"}:
                print("Request cancelled.")
                continue
        assessment = shield.inspect_inbound(prompt, "terminal")
        if assessment.action == "ELIMINATE":
            print("GOLDEN SHIELD // THREAT ELIMINATED // " + assessment.reason)
            continue
        if assessment.action == "BLOCK":
            print("GOLDEN SHIELD // BLOCKED // " + assessment.reason)
            continue
        if assessment.action == "QUARANTINE":
            if assessment.rate_limited:
                print("GOLDEN SHIELD // RATE LIMITED // " + assessment.reason)
                continue
            review = input("GOLDEN SHIELD // APPROVAL REQUIRED // continue? [y/N] ").strip().lower()
            if review not in {"y", "yes"}:
                print("Action cancelled.")
                continue
        verdict = assessment.zyra_verdict
        if not verdict:
            verdict = zyra.inspect(prompt, "input")
            if not verdict.allowed:
                print("ZYRA BLOCKED // " + "; ".join(verdict.reasons))
                continue
        model_prompt = unreal.ground_prompt(verdict.text)
        history.append({"role": "user", "content": model_prompt})
        print(GREEN + ("doug (deep think) > " if deep_think else "doug > ") + RESET, end="")
        if deep_think:
            final_text, think_passes = deep_think_chat(history, zyra)
            out_assessment = shield.inspect_outbound(final_text, "model")
            if out_assessment.action == "BLOCK":
                print("GOLDEN SHIELD // OUTPUT BLOCKED // " + out_assessment.reason)
                continue
            safe_text = out_assessment.zyra_verdict.text if out_assessment.zyra_verdict else final_text
            body_state("TALK", safe_text[:160])
            print(safe_text)
            if len(think_passes) > 1 and think_passes[0].text != think_passes[-1].text:
                print("DEEP THINK // revised after self-critique")
            if final_text:
                history.append({"role": "assistant", "content": final_text})
            body_state("IDLE", "ready")
        else:
            answer = chat(history)
            if answer:
                out_assessment = shield.inspect_outbound(answer, "model")
                if out_assessment.action == "BLOCK":
                    print("GOLDEN SHIELD // OUTPUT BLOCKED // " + out_assessment.reason)
                    continue
                safe_text = out_assessment.zyra_verdict.text if out_assessment.zyra_verdict else answer
                body_state("TALK", safe_text[:160])
                print(safe_text)
                if safe_text != answer:
                    print("GOLDEN SHIELD // output was sterilized")
                history.append({"role": "assistant", "content": safe_text})
                body_state("IDLE", "ready")


if __name__ == "__main__":
    main()
