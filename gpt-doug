            print("\nSignal closed.")
            return
        if not prompt:
            continue
        if prompt == "/quit":
            body_state("SLEEP", "terminal closed")
            if body_relay:
                body_relay.close()
            return
        if prompt == "/clear":
            history.clear()
            print("Memory cleared.")
            continue
        if prompt == "/help":
            print("/help  /clear  /mission  /zyra  /shield  /sentinel  /scan  /compliance  /ontology  /hive  /matrix  /matrix checkpoint  /matrix publish <channel> <message>  /matrix propose <statement>  /matrix vote <decision> <SUPPORT|DISSENT|ABSTAIN>  /body  /body link  /body ping  /accelerator  /apm-law  /cloud-nxyz  /automation-template  /summon <job>  /unreal  /unreal on|off  /unreal search <query>  /unreal sources [query]  /unreal mcp  /palantir  /deepthink  /eureka 369  /quit")
