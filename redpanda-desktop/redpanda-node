#!/usr/bin/env bash
set -euo pipefail

MARKER=".gpt-redpanda-node"
MODE="${1:-run}"
shift || true
PLIST="$HOME/Library/LaunchAgents/com.sonoxo.gpt-redpanda.plist"
LABEL="com.sonoxo.gpt-redpanda"

find_node() {
  if [[ -n "${REDPANDA_USB_ROOT:-}" && -f "${REDPANDA_USB_ROOT}/${MARKER}" ]]; then
    printf '%s\n' "${REDPANDA_USB_ROOT}"
    return 0
  fi
  local p
  for p in /Volumes/*; do
    [[ -d "$p" ]] || continue
    if [[ -f "$p/${MARKER}" && -f "$p/GPT-REDPANDA/redpanda_agent.py" ]]; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  return 1
}

NODE="$(find_node || true)"
if [[ -z "$NODE" ]]; then
  echo "🐼 GPT-REDPANDA USB node not mounted." >&2
  exit 3
fi

export REDPANDA_USB_ROOT="$NODE"
export REDPANDA_EVENT_FILE="$NODE/.redpanda/events/terminal-events.tsv"
PYTHON_BIN="$(command -v python3 || true)"
if [[ -z "$PYTHON_BIN" ]]; then
  echo "GPT-REDPANDA requires python3." >&2
  exit 2
fi

start_desktop_service() {
  [[ -f "$PLIST" ]] || { echo "LaunchAgent plist not found: $PLIST" >&2; exit 2; }
  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  launchctl enable "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
}

stop_desktop_service() {
  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
}

case "$MODE" in
  run)
    exec "$PYTHON_BIN" "$NODE/GPT-REDPANDA/redpanda_agent.py" "$@"
    ;;
  lan|mobile)
    stop_desktop_service
    echo "📱 GPT-REDPANDA mobile/LAN mode. Control-C to stop; run 'redpanda-node desktop' to restore the background desktop service."
    exec "$PYTHON_BIN" "$NODE/GPT-REDPANDA/redpanda_agent.py" --lan "$@"
    ;;
  desktop)
    start_desktop_service
    sleep 2
    TOKEN="$(cat "$NODE/.redpanda/portal-token" 2>/dev/null || true)"
    PORT="${REDPANDA_PORT:-8765}"
    open "http://127.0.0.1:${PORT}/?token=${TOKEN}"
    ;;
  stop)
    stop_desktop_service
    echo "🐼 GPT-REDPANDA desktop service stopped."
    ;;
  cpr)
    exec "$PYTHON_BIN" "$NODE/GPT-REDPANDA/redpanda_agent.py" --cpr-now "$@"
    ;;
  open)
    TOKEN="$(cat "$NODE/.redpanda/portal-token" 2>/dev/null || true)"
    PORT="${REDPANDA_PORT:-8765}"
    URL="http://127.0.0.1:${PORT}/?token=${TOKEN}"
    open "$URL"
    ;;
  status)
    cat "$NODE/.redpanda/status.json" 2>/dev/null || echo '{"state":"unknown"}'
    ;;
  *)
    echo "Usage: redpanda-node {run|open|status|cpr|mobile|desktop|stop}" >&2
    exit 2
    ;;
esac
