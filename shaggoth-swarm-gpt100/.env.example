SHAGGOTH_AGENT_COUNT=100
SHAGGOTH_MAX_FANOUT=16
SHAGGOTH_MAX_DEPTH=2
SHAGGOTH_ADAPTER=mock
SHAGGOTH_BASE_URL=https://api.openai.com/v1
SHAGGOTH_MODEL=
OPENAI_API_KEY=

# Capability profiles: reasoning | local-dev | integrations | full-authorized
# full-authorized enables every supported legitimate capability, but resource
# scopes are still required before scoped handlers may run.
SHAGGOTH_CAPABILITY_PROFILE=reasoning
SHAGGOTH_EXTRA_CAPABILITIES=
SHAGGOTH_DENY_CAPABILITIES=

# Visible service identity. Do not impersonate unrelated software.
SHAGGOTH_SERVICE_NAME=shaggoth-swarm-gpt100
SHAGGOTH_SERVICE_VERSION=0.3.0

# Explicitly authorized endpoints only. Comma-separated.
SHAGGOTH_AUTHORIZED_ENDPOINTS=
SHAGGOTH_CONNECT_INTERVAL_SECONDS=30
SHAGGOTH_CONNECT_TIMEOUT_SECONDS=10
SHAGGOTH_CONNECT_MAX_BYTES=65536

# Optional standard bearer authentication for approved endpoints.
SHAGGOTH_CONNECT_BEARER_TOKEN=

# Bounded production-style retry behavior.
SHAGGOTH_CONNECT_MAX_RETRIES=2
SHAGGOTH_CONNECT_RETRY_BACKOFF_SECONDS=1
