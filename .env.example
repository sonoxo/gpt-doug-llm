# GPT Doug LLM — Environment Configuration
# FREE MODE IS DEFAULT. No paid APIs. No surprise bills.
# Copy to .env and customize. NEVER commit .env.

# ═══════════════════════════════════════════════════════════
# AI PROVIDERS (all optional; offline workspace is the default)
# ═══════════════════════════════════════════════════════════
GPT_DOUG_PROVIDER=none
# GPT_DOUG_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash
# FREE_MODE=true
# GPT_DOUG_PROVIDER=openai
# PAID_MODE=false
# OPENAI_API_KEY=your-paid-key-here
# OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════
# AGENT CONFIG
# ═══════════════════════════════════════════════════════════
AGENT_PLANNER_MODEL=qwen2.5-coder:7b
AGENT_EXECUTOR_MODEL=qwen2.5-coder:7b
AGENT_REVIEWER_MODEL=qwen2.5-coder:7b
AGENT_MAX_SPAWN_DEPTH=4
AGENT_MAX_TOTAL_SUBAGENTS=25
# GPT_DOUG_ENABLE_WORKER=false

# ═══════════════════════════════════════════════════════════
# SECURITY / IDENTITY
# ═══════════════════════════════════════════════════════════
# GPT_DOUG_VERIFIED_BUSINESS_EMAIL=builder@example.com
# GPT_DOUG_ALLOWED_EMAIL_DOMAINS=example.com
# GPT_DOUG_VERIFIED_PHONE=+12125550123
# GPT_DOUG_JURISDICTION=US-NY
# GPT_DOUG_ORG_TYPE=individual
# GPT_DOUG_ROLE=developer
# GPT_DOUG_HUMAN_OVERSIGHT=true

# ═══════════════════════════════════════════════════════════
# PUBLIC-SECTOR COMPLIANCE PROFILE
# ═══════════════════════════════════════════════════════════
# Profiles: commercial | federal | ic | cjis
# These flags are technical assertions, NOT proof of an ATO, clearance,
# accreditation, CJIS approval, personnel eligibility, or facility approval.
# Production government deployments MUST inject them from a trusted policy /
# identity plane; do not treat user-controlled environment variables as evidence.
#
# GPT_DOUG_COMPLIANCE_PROFILE=federal
# GPT_DOUG_GOV_AUTHORIZED=false
# GPT_DOUG_SYSTEM_AUTHORIZED=false
# GPT_DOUG_APPROVED_SYSTEM_BOUNDARY=false
# GPT_DOUG_AUDIT_ENFORCED=false
# GPT_DOUG_IR_READY=false
#
# Intelligence Community / classified handling gates:
# GPT_DOUG_COMPLIANCE_PROFILE=ic
# GPT_DOUG_PERSONNEL_ELIGIBLE=false
# GPT_DOUG_NEED_TO_KNOW=false
# GPT_DOUG_APPROVED_CLASSIFIED_FACILITY=false
# GPT_DOUG_CLASSIFICATION_CEILING=UNCLASSIFIED
# Allowed ceiling values: UNCLASSIFIED, CUI, CONFIDENTIAL, SECRET, TOP_SECRET, TS_SCI
# GPT_DOUG_SCI_ACCESS_AUTHORIZED=false
#
# FBI CJIS / CJI handling gates:
# GPT_DOUG_COMPLIANCE_PROFILE=cjis
# GPT_DOUG_CJI_AUTHORIZED=false
# GPT_DOUG_MFA_ENFORCED=false
# GPT_DOUG_ENCRYPTION_ENFORCED=false
# GPT_DOUG_AUDIT_ENFORCED=false
# GPT_DOUG_IR_READY=false

# ═══════════════════════════════════════════════════════════
# GOOGLE CLOUD
# ═══════════════════════════════════════════════════════════
# GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_PROJECT_ID=your-project-id

# ═══════════════════════════════════════════════════════════
# RULES
# ═══════════════════════════════════════════════════════════
# 1. Default: offline workspace. No network provider is contacted.
# 2. OpenAI is BLOCKED unless PAID_MODE=true.
# 3. Government/classified/CJI flags are fail-closed technical gates only.
# 4. Never claim government certification from configuration alone.
# 5. Classified/CJI production use requires the owning authority's real approval,
#    approved infrastructure, personnel/access determinations, and operational controls.
