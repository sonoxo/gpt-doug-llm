# GPT-DOUG / CL1 — NO-CHARGE LOCAL-ONLY PROFILE
# Never store real API keys in committed files.
# No cloud inference, even if legacy PAID_MODE=true is present.
GPT_DOUG_FREE_ONLY=true
PAID_MODE=false
GPT_DOUG_PROVIDER=ollama
GPT_DOUG_PROVIDER_ORDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Optional: use GPT_DOUG_PROVIDER=none for explicitly offline inspection.
# Commercial inference (OpenAI, Anthropic, Gemini, hosted Qwen) is blocked
# by CL1 inference policy; free cloud tiers are not a no-billing guarantee.

# ═══════════════════════════════════════════════════════════
# LIVE EARTH / N2YO ORBITAL DATA (optional)
# ═══════════════════════════════════════════════════════════
# Preferred: point every downstream app at one quota-aware MMGIS/XUNIA proxy.
# XUNIA_N2YO_PROXY_URL=http://localhost:8888/api/n2yo
# Standalone fallback only. Keep the N2YO key server-side and never expose it
# through browser code, VITE_ variables, committed config, or logs.
# N2YO_API_KEY=your-private-n2yo-key
# N2YO_TIMEOUT_MS=10000

# ═══════════════════════════════════════════════════════════
# PALANTIR FOUNDRY / ONTOLOGY / AIP / GOTHAM / DEFENSE OSDK /
# AUTOMATE / APOLLO / JUPYTERLAB CODE WORKSPACES
# ═══════════════════════════════════════════════════════════

# Foundry enrollment you are explicitly authorized to use.
# FOUNDRY_BASE_URL=https://your-enrollment.palantirfoundry.com
# FOUNDRY_CLIENT_ID=your-client-id
# FOUNDRY_CLIENT_SECRET=your-client-secret
# Alternative to OAuth client credentials:
# FOUNDRY_TOKEN=your-token
# FOUNDRY_ALLOWED_HOST=your-enrollment.palantirfoundry.com

# Add only scopes your application needs. AIP/Logic availability is additionally
# governed by enrollment entitlement and resource permissions.
FOUNDRY_SCOPES=api:ontologies-read
FOUNDRY_ENABLE_WRITES=false
FOUNDRY_TIMEOUT_SECONDS=10

# Platform capability gates. These do not create licenses, permissions,
# government affiliation, mission authority, or weapons-release authority.
PALANTIR_AIP_ENABLED=false
PALANTIR_AUTOMATE_ENABLED=false
PALANTIR_GOTHAM_ENABLED=false
PALANTIR_DEFENSE_OSDK_ENABLED=false
PALANTIR_APOLLO_ENABLED=false
PALANTIR_JUPYTER_ENABLED=false

# AIP live verification / Wakeup3lm routing.
# Model must be a model resource identifier enabled on the enrollment.
# PALANTIR_AIP_MODEL=ri.language-model-service..language-model.your-model
# Published AIP Logic / Function Query target used by readiness and eval tooling.
# PALANTIR_AIP_ONTOLOGY=your-ontology-api-name
# PALANTIR_AIP_LOGIC_QUERY=your-published-query-api-name

# Defense OSDK is a tenant-generated, typed application layer. The local runtime
# can route intelligence, mission-planning, order-of-battle and sustainment when
# an authorized OSDK client is provisioned. Autonomous local targeting-and-fires
# execution is intentionally not exposed by this integration.

# Gotham — separate authorized endpoint and identity.
# GOTHAM_BASE_URL=https://your-authorized-gotham-host
# GOTHAM_TOKEN=your-test-or-service-token
# Or OAuth service credentials:
# GOTHAM_CLIENT_ID=your-client-id
# GOTHAM_CLIENT_SECRET=your-client-secret
# GOTHAM_SCOPES=
# GOTHAM_ALLOWED_HOST=your-authorized-gotham-host
GOTHAM_ENABLE_WRITES=false

# Apollo Hub — live GraphQL inspection + guarded apollo-cli Product Release publish.
# APOLLO_URL=https://your-apollo-hub
# APOLLO_TOKEN=your-apollo-token
# Or Apollo service-account credentials for CLI publishing:
# APOLLO_CLIENT_ID=your-client-id
# APOLLO_CLIENT_SECRET=your-client-secret
# GraphQL endpoint is copied from your Apollo Hub/API Explorer configuration.
# APOLLO_GRAPHQL_URL=https://your-apollo-hub/your-graphql-endpoint
# APOLLO_CLI=apollo-cli
APOLLO_TIMEOUT_SECONDS=20

# Optional legacy event-only sink used by Zyra.
# FOUNDRY_SECURITY_ENDPOINT=https://your-foundry-host/your-approved-event-endpoint

# ═══════════════════════════════════════════════════════════
# ENGINEERING PROFILE
# ═══════════════════════════════════════════════════════════

# Provider-neutral engineering defaults derived from America's AI Action Plan
# (July 2025): open/local options, evaluation, secure-by-design engineering,
# incident readiness, compute efficiency, provenance, and human control.
# This is not a claim of U.S. Government endorsement or certification.
GPT_DOUG_AI_ACTION_PLAN=1

# ═══════════════════════════════════════════════════════════
# TERMINAL AGENT HARDENING (all optional)
# ═══════════════════════════════════════════════════════════
GPT_DOUG_AGENT_MAX_STEPS=40
GPT_DOUG_AGENT_CONTEXT_CHARS=48000
GPT_DOUG_AGENT_COMMAND_TIMEOUT=300

# ═══════════════════════════════════════════════════════════
# AGENT CONFIG (all optional)
# ═══════════════════════════════════════════════════════════
AGENT_PLANNER_MODEL=qwen2.5-coder:7b
AGENT_EXECUTOR_MODEL=qwen2.5-coder:7b
AGENT_REVIEWER_MODEL=qwen2.5-coder:7b
AGENT_MAX_SPAWN_DEPTH=4
AGENT_MAX_TOTAL_SUBAGENTS=25
# GPT_DOUG_ENABLE_WORKER=false

# ═══════════════════════════════════════════════════════════
# SECURITY (all optional — uses OS Keychain if not set)
# ═══════════════════════════════════════════════════════════
# GPT_DOUG_VERIFIED_BUSINESS_EMAIL=builder@example.com
# GPT_DOUG_ALLOWED_EMAIL_DOMAINS=example.com
# GPT_DOUG_VERIFIED_PHONE=+12125550123
# GPT_DOUG_JURISDICTION=US-NY
# GPT_DOUG_ORG_TYPE=individual
# GPT_DOUG_ROLE=developer
# GPT_DOUG_HUMAN_OVERSIGHT=true

# ═══════════════════════════════════════════════════════════
# GOOGLE CLOUD (all optional — for hackathon deployment)
# ═══════════════════════════════════════════════════════════
# GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_PROJECT_ID=your-project-id

# ═══════════════════════════════════════════════════════════
# RULES
# ═══════════════════════════════════════════════════════════
# 1. Default: offline workspace. No network provider is contacted.
# 2. Remote Qwen is not contacted without an explicit provider selection and key.
# 3. No accidental charges. No surprise bills.
# 4. Ollama is optional and disabled unless explicitly selected.
# 5. GPT_DOUG_AI_ACTION_PLAN=0 disables only this engineering profile; baseline security rules still apply.
# 6. Palantir access uses only hosts and permissions you explicitly configure.
# 7. Foundry/Gotham writes remain disabled unless their write gate is explicitly enabled.
# 8. Palantir capability flags never manufacture entitlement, credentials, licensing, government affiliation, mission authority, or weapons-release authority.
# 9. `/palantir probe` verifies configured live surfaces without executing an AIP model.
# 10. `/palantir probe-model` performs an explicit live AIP model request and may consume tenant quota.
# 11. Prefer XUNIA_N2YO_PROXY_URL so orbital clients share one cache/quota envelope; never expose N2YO_API_KEY to browser code.
