# GPT Doug LLM — Environment Configuration
# FREE MODE IS DEFAULT. No paid APIs. No surprise bills.
# Copy to .env and customize. NEVER commit .env.

# ═══════════════════════════════════════════════════════════
# AI PROVIDERS (all optional; offline workspace is the default)
# ═══════════════════════════════════════════════════════════

# Explicit provider selection:
# none, qwen, gemini, openai, claude, anthropic, ollama, auto, or xunia.
GPT_DOUG_PROVIDER=none

# Qwen — local OpenAI-compatible mode (free if you host the model yourself)
# Example model follows the Qwen3.8-Flash-Next open release.
# GPT_DOUG_PROVIDER=qwen
# QWEN_BASE_URL=http://127.0.0.1:8000/v1
# QWEN_MODEL=Qwen/Qwen3.8-Flash-Next

# Qwen — Alibaba Cloud Model Studio OpenAI-compatible mode (may incur charges)
# Remote Qwen is disabled unless a valid QWEN_API_KEY or DASHSCOPE_API_KEY is set.
# GPT_DOUG_PROVIDER=qwen
# QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=your-model-studio-key
# QWEN_MODEL=qwen3.7-plus

# Gemini Free Tier (optional — subject to Google's current free-tier limits)
# GPT_DOUG_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash
# FREE_MODE=true

# OpenAI (paid unless your account/plan says otherwise)
# GPT_DOUG_PROVIDER=openai
# PAID_MODE=false
# OPENAI_API_KEY=your-paid-key-here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional; may incur charges)
# GPT_DOUG_PROVIDER=claude
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama remains an optional legacy local provider.
# GPT_DOUG_PROVIDER=ollama
# OLLAMA_MODEL=gpt-doug
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ═══════════════════════════════════════════════════════════
# PALANTIR FOUNDRY / AIP (optional)
# ═══════════════════════════════════════════════════════════

# The base URL of the Foundry enrollment you are authorized to use.
# Example: https://your-enrollment.palantirfoundry.com
# FOUNDRY_BASE_URL=https://your-foundry-host

# OAuth client-credentials from a Palantir Developer Console application.
# Use these for service-to-service access. Never commit real values.
# FOUNDRY_CLIENT_ID=your-client-id
# FOUNDRY_CLIENT_SECRET=your-client-secret

# Alternative: an explicitly issued bearer token can be used instead of
# FOUNDRY_CLIENT_ID + FOUNDRY_CLIENT_SECRET.
# FOUNDRY_TOKEN=your-token

# Host pinning prevents a changed URL from sending credentials elsewhere.
# FOUNDRY_ALLOWED_HOST=your-foundry-host

# Read-only is the safe default. Add write scope only when needed.
FOUNDRY_SCOPES=api:ontologies-read
FOUNDRY_ENABLE_WRITES=false
FOUNDRY_TIMEOUT_SECONDS=10

# Optional legacy event-only sink used by Zyra. The new Palantir client above
# is the primary GPT-DOUG -> Foundry integration.
# FOUNDRY_SECURITY_ENDPOINT=https://your-foundry-host/your-approved-event-endpoint

# ═══════════════════════════════════════════════════════════
# ENGINEERING PROFILE
# ═══════════════════════════════════════════════════════════

# Provider-neutral engineering defaults derived from America's AI Action Plan
# (July 2025): open/local options, evaluation, secure-by-design engineering,
# incident readiness, compute efficiency, provenance, and human control.
# This is not a claim of U.S. Government endorsement or certification.
GPT_DOUG_AI_ACTION_PLAN=1

# ═══════════════════════════════════════════════════════════
# TERMINAL AGENT HARDENING (all optional)
# ═══════════════════════════════════════════════════════════

# The verification-first terminal agent now keeps longer jobs alive while
# compacting old observations, rejecting repeated failed commands, and writing
# verification evidence under .doug/terminal-verification.jsonl.
# GPT_DOUG_AGENT_MODEL=Qwen/Qwen3.8-Flash-Next
GPT_DOUG_AGENT_MAX_STEPS=40
GPT_DOUG_AGENT_CONTEXT_CHARS=48000
GPT_DOUG_AGENT_COMMAND_TIMEOUT=300

# ═══════════════════════════════════════════════════════════
# AGENT CONFIG (all optional)
# ═══════════════════════════════════════════════════════════

AGENT_PLANNER_MODEL=qwen2.5-coder:7b
AGENT_EXECUTOR_MODEL=qwen2.5-coder:7b
AGENT_REVIEWER_MODEL=qwen2.5-coder:7b
AGENT_MAX_SPAWN_DEPTH=4
AGENT_MAX_TOTAL_SUBAGENTS=25
# GPT_DOUG_ENABLE_WORKER=false

# ═══════════════════════════════════════════════════════════
# SECURITY (all optional — uses OS Keychain if not set)
# ═══════════════════════════════════════════════════════════

# GPT_DOUG_VERIFIED_BUSINESS_EMAIL=builder@example.com
# GPT_DOUG_ALLOWED_EMAIL_DOMAINS=example.com
# GPT_DOUG_VERIFIED_PHONE=+12125550123
# GPT_DOUG_JURISDICTION=US-NY
# GPT_DOUG_ORG_TYPE=individual
# GPT_DOUG_ROLE=developer
# GPT_DOUG_HUMAN_OVERSIGHT=true

# ═══════════════════════════════════════════════════════════
# GOOGLE CLOUD (all optional — for hackathon deployment)
# ═══════════════════════════════════════════════════════════

# GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_PROJECT_ID=your-project-id

# ═══════════════════════════════════════════════════════════
# RULES
# ═══════════════════════════════════════════════════════════
# 1. Default: offline workspace. No network provider is contacted.
# 2. Remote Qwen is not contacted without an explicit provider selection and key.
# 3. No accidental charges. No surprise bills.
# 4. Ollama is optional and disabled unless explicitly selected.
# 5. GPT_DOUG_AI_ACTION_PLAN=0 disables only this engineering profile; baseline security rules still apply.
# 6. Palantir access uses only the Foundry host and permissions you configure.
# 7. Foundry writes remain disabled unless FOUNDRY_ENABLE_WRITES=true.
