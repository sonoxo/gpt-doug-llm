# GPT Doug LLM — Environment Configuration
# FREE MODE IS DEFAULT. No paid APIs. No surprise bills.
# Copy to .env and customize. NEVER commit .env.

# ═══════════════════════════════════════════════════════════
# LLM BACKEND (all FREE)
# ═══════════════════════════════════════════════════════════

# Ollama (DEFAULT — free, local, always works)
# Install: https://ollama.com
GPT_DOUG_MODEL=gpt-doug

# Gemini Free Tier (optional — free, 15 req/min, no charge)
# Get key: Google Cloud Console → Enable Generative Language API → Create key
# GEMINI_API_KEY=your-free-key-here
# GEMINI_MODEL=gemini-2.5-flash
# FREE_MODE=true

# OpenAI (BLOCKED by default — costs money!)
# To enable, you MUST explicitly set PAID_MODE=true
# PAID_MODE=false
# OPENAI_API_KEY=your-paid-key-here  # BLOCKED unless PAID_MODE=true
# OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════
# AGENT CONFIG (all optional)
# ═══════════════════════════════════════════════════════════

AGENT_PLANNER_MODEL=qwen2.5-coder:7b
AGENT_EXECUTOR_MODEL=qwen2.5-coder:7b
AGENT_REVIEWER_MODEL=qwen2.5-coder:7b
AGENT_MAX_SPAWN_DEPTH=4
AGENT_MAX_TOTAL_SUBAGENTS=25

# ═══════════════════════════════════════════════════════════
# SECURITY (all optional — uses OS Keychain if not set)
# ═══════════════════════════════════════════════════════════

# GPT_DOUG_VERIFIED_BUSINESS_EMAIL=builder@example.com
# GPT_DOUG_ALLOWED_EMAIL_DOMAINS=example.com
# GPT_DOUG_VERIFIED_PHONE=+12125550123
# GPT_DOUG_JURISDICTION=US-NY
# GPT_DOUG_ORG_TYPE=individual
# GPT_DOUG_ROLE=developer
# GPT_DOUG_HUMAN_OVERSIGHT=true

# ═══════════════════════════════════════════════════════════
# GOOGLE CLOUD (all optional — for hackathon deployment)
# ═══════════════════════════════════════════════════════════

# GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_PROJECT_ID=your-project-id

# ═══════════════════════════════════════════════════════════
# RULES
# ═══════════════════════════════════════════════════════════
# 1. Default: FREE ONLY. Ollama + Gemini free tier.
# 2. OpenAI is BLOCKED unless PAID_MODE=true.
# 3. No accidental charges. No surprise bills.
# 4. Set up Ollama first: ollama pull qwen2.5-coder:7b
