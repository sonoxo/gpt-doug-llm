{
  "name": "NXYZ Cloud — XUNIA Forge",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers-extra/features/opentofu:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "forwardPorts": [8787, 4000, 8088],
  "portsAttributes": {
    "8787": {
      "label": "NXYZ Cloud Control Center",
      "onAutoForward": "openBrowserOnce",
      "visibility": "private"
    },
    "4000": {
      "label": "LiteLLM Gateway",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8088": {
      "label": "SearXNG Research",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cp -n xunia-forge/.env.example xunia-forge/.env && chmod +x xunia-forge/forge",
  "postStartCommand": "cd xunia-forge && docker compose up -d --build",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["Continue.continue"]
    }
  }
}
