    {
      "evidenceId": "evidence-report-metadata",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "C4ADS report page header",
      "claimNature": "source_statement",
      "summary": "C4ADS published Covert Compute: How Advanced AI Chips Reach China on September 9, 2026, authored by Mishel Kondi."
    },
    {
      "evidenceId": "evidence-policy-context",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary",
      "claimNature": "source_statement",
      "summary": "C4ADS states that since 2022 the U.S. Department of Commerce Bureau of Industry and Security has used export controls to limit access by some countries, including China, to advanced semiconductor chips produced with U.S. inputs and technology."
    },
    {
      "evidenceId": "evidence-direct-acquisition",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary - Direct Acquisition by Universities and Research Institutions",
      "claimNature": "source_statement",
      "summary": "C4ADS reports that between July 2025 and January 2026 Chinese universities and research institutions procured at least 56 restricted NVIDIA chips worth US$1.7 million; the chips were bundled inside multimillion-dollar contracts and routed through uncredentialed companies."
    },
    {
      "evidenceId": "evidence-institution-ties",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary - Direct Acquisition by Universities and Research Institutions",
      "claimNature": "source_statement",
      "summary": "C4ADS states that most of the buyer institutions it identified maintain ties to the Chinese government and China's defense industrial base."
    },
    {
      "evidenceId": "evidence-transshipment",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary - Diversion and/or Transshipment through Southeast Asian Trade Networks",
      "claimNature": "source_statement",
      "summary": "C4ADS reports 50 export shipments of restricted NVIDIA GPUs diverted through Vietnam, India, and Malaysia to Hong Kong and China between 2023 and 2025, totaling approximately US$13.4 million."
    },
    {
      "evidenceId": "evidence-megaspeed",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary - Opaque Corporate Ownership Structures",
      "claimNature": "source_statement",
      "summary": "C4ADS states that Megaspeed International Pte. Ltd. was reported by Bloomberg and The New York Times as the largest Southeast Asian importer of NVIDIA hardware, with US$4.6 billion in imports from 2022 to 2025, and that its ultimate beneficial ownership network may have ties to the PRC."
    },
    {
      "evidenceId": "evidence-understatement",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary conclusion",
      "claimNature": "source_statement",
      "summary": "C4ADS cautions that its findings almost certainly understate the true volume of diverted chips because its analysis covers a limited window and tallies only chips explicitly mentioned in available records and trade data."
    },
    {
      "evidenceId": "evidence-recommendations",
      "sourceId": "c4ads-covert-compute-2026-09-09",
      "locator": "Executive Summary conclusion",
      "claimNature": "source_statement",
      "summary": "C4ADS recommends sustained coordination between BIS and regional partners, meaningful post-sale end-user verification, and private-sector compliance treated as an ongoing obligation."
    },
    {
      "evidenceId": "evidence-derived-bindings",
      "sourceId": "gpt-doug-analyst-mapping-v1",
      "locator": "Local ontology derivation",
      "claimNature": "derived_compliance_mapping",
      "summary": "The links from C4ADS recommendations to specific pathway classes are analyst-derived compliance mappings and are not represented as direct source claims."
    }
