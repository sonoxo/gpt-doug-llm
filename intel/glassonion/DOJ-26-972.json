      "sourceLines": "61"
    },
    {
      "id": "fact-operator-relationship",
      "statement": "DOJ reports that court documents describe QTFY as employed by Nanjing Xinjiuwei Network Technology Company and as creator/operator of QScan and QTRouter.",
      "claimNature": "DOJ_SUMMARY_OF_COURT_DOCUMENTS",
      "sourceLines": "62"
    },
    {
      "id": "fact-service-customers",
      "statement": "According to court documents summarized by DOJ, QTFY offered hacking services to paying customers including the PRC Ministry of State Security and People's Liberation Army.",
      "claimNature": "DOJ_SUMMARY_OF_COURT_DOCUMENTS",
      "sourceLines": "71"
    },
    {
      "id": "fact-qscan-iot",
      "statement": "DOJ describes QScan as scanning and automatically infecting IoT devices that are then added to the QTRouter network.",
      "claimNature": "DOJ_PRESS_RELEASE_REPORTING",
      "sourceLines": "71"
    },
    {
      "id": "fact-qtrouter-obfuscation",
      "statement": "DOJ describes QTRouter as comprising compromised IoT devices, commercial proxy devices, and leased VPS infrastructure used as an obfuscation network.",
      "claimNature": "DOJ_PRESS_RELEASE_REPORTING",
      "sourceLines": "72"
    },
    {
      "id": "fact-hardcoded-domains",
      "statement": "DOJ states that seized domains were hard-coded into QScan and QTRouter and used for essential communication and authentication, making the platforms inoperable after seizure.",
      "claimNature": "DOJ_PRESS_RELEASE_REPORTING",
      "sourceLines": "73"
    },
    {
      "id": "fact-joint-advisory",
