# ZYRA Intelligence Cloud
# Private business-intelligence and cyber-defense platform.

AGENCY_ENVIRONMENT=development
AGENCY_SERVICE_NAME=ZYRA Intelligence Cloud
AGENCY_DEFAULT_WORKSPACE=ZYRA Command

# Local single-node default:
AGENCY_DATABASE_URL=sqlite+pysqlite:///./agency_cloud/.data/agency.db

# Production: use a managed PostgreSQL URL instead.
# AGENCY_DATABASE_URL=postgresql+psycopg://user:password@host:5432/zyra_intel

# Generate strong random secrets before production deployment.
AGENCY_AUDIT_KEY=
AGENCY_DIRECTOR_TOKEN=
AGENCY_ANALYST_TOKEN=
AGENCY_AUDITOR_TOKEN=
AGENCY_CLIENT_TOKEN=

# Development only. Never enable in production.
AGENCY_ALLOW_DEMO_AUTH=true

# docker-compose only
POSTGRES_PASSWORD=
