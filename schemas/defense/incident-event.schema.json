{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sonoxo/gpt-doug-llm/blob/main/schemas/defense/incident-event.schema.json",
  "title": "Defensive Incident Event",
  "description": "Validated event contract for authorized defensive awareness and synthetic exercises. Not a targeting or engagement message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "category",
    "observed_at",
    "ingested_at",
    "source",
    "provenance",
    "verification",
    "classification"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "category": {
      "enum": [
        "hazard",
        "infrastructure_status",
        "sensor_health",
        "service_disruption",
        "weather",
        "public_safety_incident",
        "synthetic_exercise",
        "analyst_note"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_type": {
          "enum": [
            "authorized_feed",
            "operator",
            "public_dataset",
            "synthetic_generator"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref"
      ],
      "properties": {
        "record_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude",
        "latitude",
        "crs"
      ],
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "uncertainty_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "severity": {
      "enum": [
        "informational",
        "low",
        "moderate",
        "high",
        "critical",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification": {
      "enum": [
        "unverified",
        "corroborated",
        "verified",
        "disputed",
        "stale"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 50
    },
    "exercise_only": {
      "type": "boolean",
      "default": false
    }
  }
}