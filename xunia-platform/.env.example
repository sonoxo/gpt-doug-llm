# XUNIA Platform production baseline
XUNIA_PLATFORM_HOST=0.0.0.0
XUNIA_PLATFORM_PORT=4400
XUNIA_DATA_DIR=/data
XUNIA_AUTH_REQUIRED=1
# JSON map token -> role or object. Generate long random tokens; never commit real values.
XUNIA_API_KEYS={"replace-admin-token":{"role":"admin","subject":"platform-admin"},"replace-operator-token":{"role":"operator","subject":"platform-operator"},"replace-viewer-token":{"role":"viewer","subject":"platform-viewer"}}
XUNIA_RATE_LIMIT_PER_MIN=300
XUNIA_MAX_BODY_BYTES=1000000
XUNIA_TRUST_PROXY=0
XUNIA_CORS_ORIGIN=
XUNIA_METRICS_PUBLIC=0
XUNIA_CHAIN_URL=http://xunia-chain:4317
SONOXO_URL=http://sonoxo:3001/api/sonoxo/harvest
# Optional model gateway. If absent, AIP uses the local deterministic fallback.
XUNIA_MODEL_URL=
XUNIA_MODEL_TOKEN=
XUNIA_MODEL_TIMEOUT_MS=30000
