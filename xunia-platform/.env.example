# XUNIA Platform production baseline
XUNIA_PLATFORM_HOST=0.0.0.0
XUNIA_PLATFORM_PORT=4400
XUNIA_DATA_DIR=/data
XUNIA_AUTH_REQUIRED=1
# JSON map token -> role/object. Optional realm binds a credential to the sovereign deployment realm.
XUNIA_API_KEYS={"replace-admin-token":{"role":"admin","subject":"platform-admin","realm":"xunia-us-va"},"replace-operator-token":{"role":"operator","subject":"platform-operator","realm":"xunia-us-va"},"replace-viewer-token":{"role":"viewer","subject":"platform-viewer","realm":"xunia-us-va"}}
XUNIA_RATE_LIMIT_PER_MIN=300
XUNIA_MAX_BODY_BYTES=1000000
XUNIA_TRUST_PROXY=0
XUNIA_CORS_ORIGIN=
XUNIA_METRICS_PUBLIC=0

# Sovereignty boundary. Enable only after setting region, realm, encryption key, and egress policy.
XUNIA_SOVEREIGNTY_ENFORCED=1
XUNIA_REALM_ID=xunia-us-va
XUNIA_REGION=us-va
XUNIA_ALLOWED_REGIONS=us-va
XUNIA_AIR_GAPPED=0
# Exact external origins only. Private/loopback/internal service targets are allowed automatically.
XUNIA_EGRESS_ALLOWLIST=
XUNIA_KEY_AUTHORITY=customer
XUNIA_CUSTOMER_KEY_ID=replace-with-kms-or-hsm-key-id
XUNIA_REQUIRE_ENCRYPTED_STATE=1
# Generate with: openssl rand -base64 32
XUNIA_STATE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Optional integrity lock. Set to the approved policy fingerprint after deployment validation.
XUNIA_SOVEREIGNTY_EXPECTED_SHA256=

XUNIA_CHAIN_URL=http://xunia-chain:4317
SONOXO_URL=http://sonoxo:3001/api/sonoxo/harvest
# Optional model gateway. In sovereign mode, public gateways must be explicitly allowlisted above.
XUNIA_MODEL_URL=
XUNIA_MODEL_TOKEN=
XUNIA_MODEL_TIMEOUT_MS=30000
