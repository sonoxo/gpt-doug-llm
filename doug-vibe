#!/bin/zsh
set -e

cd ~/gpt-doug-llm
source .venv-mlx/bin/activate

export GPT_DOUG_PROVIDER=qwen
export QWEN_MODEL="${QWEN_MODEL:-mlx-community/Qwen2.5-Coder-3B-Instruct-4bit}"
export GPT_DOUG_MODEL="$QWEN_MODEL"
unset OLLAMA_HOST OLLAMA_API_BASE OLLAMA_BASE_URL OLLAMA_MODEL

OBJECTIVE="$*"

if [ -z "$OBJECTIVE" ]; then
  echo 'Usage: ./doug-vibe "what you want built"'
  exit 1
fi

SCRIPTS=$(python - <<'PY'
import json
from pathlib import Path
p=Path("package.json")
if p.exists():
    print(json.dumps(json.loads(p.read_text()).get("scripts", {})))
else:
    print("{}")
PY
)

PYPROJECT=$([ -f pyproject.toml ] && echo yes || echo no)
TESTS=$([ -d tests ] && echo yes || echo no)

GPT_DOUG_MAX_STEPS=8 ./doug-qwen agent "
VIBE COMMAND:
$OBJECTIVE

KNOWN REPOSITORY FACTS:
- package.json scripts: $SCRIPTS
- pyproject.toml exists: $PYPROJECT
- Python tests directory exists: $TESTS
- Ollama is forbidden.
- Port 11434 is forbidden.

EXECUTE FAST:
1. Inspect only the files directly relevant to the request.
2. Do not invent npm scripts.
3. Do not run npm run build unless package.json explicitly contains build.
4. For Python verification prefer: python -m pytest -q
5. For JavaScript verification without a build script use: node --check <changed-file>
6. Make a real code change by step 3 whenever implementation is requested.
7. Run targeted verification.
8. Repair failures once.
9. Finish when verified.
10. Preserve existing work and Heat Seek.
"
