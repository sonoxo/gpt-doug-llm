{
  "ontology": "ZYRA_JUKEBOX_v3",
  "product": "ZYRA JUKEBOX",
  "module": "zyra-jukebox",
  "class": "MusicPlaybackGateway",
  "parentEcosystem": "GPT-DOUG-LLM / ZYRA / XUNIA",
  "purpose": "Federated, source-aware music and live-radio discovery, playback, saving, queue control, and RetroViz 95 visualization.",
  "entities": {
    "Artist": ["name", "sourceId", "source"],
    "Track": ["title", "artist", "source", "sourceUrl", "playbackMode", "rightsContext"],
    "RadioStation": ["stationUuid", "name", "streamUrl", "countryCode", "tags", "codec", "bitrate", "source"],
    "MusicDirectory": ["name", "searchUrl", "playbackCapability"],
    "PlaybackSession": ["item", "source", "startedAt", "mode", "volume"],
    "QueueItem": ["item", "position", "kind"],
    "SavedItem": ["item", "savedAt", "storageMode"],
    "Visualizer": ["name", "mode", "audioReactive", "fallbackMode"],
    "Controller": ["playPause", "stop", "previous", "next", "seek", "volume"]
  },
  "relations": [
    "Artist CREATES Track",
    "Track DISCOVERED_VIA MusicDirectory",
    "RadioStation DISCOVERED_VIA MusicDirectory",
    "PlaybackSession PLAYS Track",
    "PlaybackSession PLAYS RadioStation",
    "QueueItem REFERENCES Track",
    "QueueItem REFERENCES RadioStation",
    "SavedItem REFERENCES Track",
    "SavedItem REFERENCES RadioStation",
    "Visualizer REACTS_TO PlaybackSession",
    "Controller CONTROLS PlaybackSession"
  ],
  "sources": ["Radio Browser", "Internet Archive", "SoundCloud", "YouTube", "Bandcamp", "Audius", "Jamendo", "Local Audio"],
  "storage": {
    "favorites": "browser localStorage",
    "queue": "browser localStorage",
    "session": "browser localStorage",
    "portableBackup": "JSON export"
  },
  "policy": {
    "preserve_source_provenance": true,
    "no_rebroadcast_of_restricted_catalogs": true,
    "use_authorized_embed_or_direct_playback": true,
    "radio_directory_public_data_only": true,
    "core_paid_api_requirement": false
  }
}
