{
  "manifest_version": 3,
  "name": "XUNIA ZYRA Chaotic Good Gateway",
  "version": "0.2.0",
  "description": "Local browser shield and user-controlled capability gateway for XUNIA, ZYRA, Palantir Foundry, GitHub, and localhost.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://*.palantirfoundry.com/*",
    "https://github.com/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "XUNIA ZYRA Chaotic Good Gateway",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.palantirfoundry.com/*",
        "https://github.com/*",
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
