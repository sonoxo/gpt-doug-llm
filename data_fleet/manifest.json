      "related_to": []
    },
    {
      "id": "xunia-openweb-routes",
      "name": "XUNIA Public Route Reference Map",
      "path": "docs/open-web-atlas/seed-map.json",
      "format": "json",
      "rows_key": "pages",
      "category": "documented-routes",
      "sensitivity": "public",
      "approved": true,
      "provenance": "https://github.com/sonoxo/gpt-doug-llm/blob/main/docs/open-web-atlas/seed-map.json",
      "related_to": [
        "xunia-resource-registry"
      ]
    }
  ]
