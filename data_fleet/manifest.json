      "category": "repository-topology",
      "sensitivity": "public",
      "approved": true,
      "provenance": "https://github.com/sonoxo/gpt-doug-llm/blob/main/docs/ecosystem-observatory/snapshot.json",
      "related_to": [
        "xunia-resource-registry"
      ]
    },
    {
      "id": "glass-onion-sources",
      "name": "Glass Onion Public Source Atlas",
      "path": "catalog/glass-onion-15.json",
      "format": "json",
      "rows_key": "slots",
      "category": "source-attribution",
      "sensitivity": "public",
      "approved": true,
      "provenance": "https://github.com/sonoxo/gpt-doug-llm/blob/main/catalog/glass-onion-15.json",
      "related_to": [
        "xunia-resource-registry"
      ]
    },
    {
      "id": "xunia-resource-registry",
      "name": "XUNIA Interactive Resource Directory",
      "path": "docs/resources.json",
      "format": "json",
      "rows_key": "items",
      "category": "application-registry",
      "sensitivity": "public",
      "approved": true,
