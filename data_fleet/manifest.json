{
  "schema": "gpt-doug.dataset-fleet.manifest.v1",
  "policy": {
    "mode": "local-only",
    "publicOnly": true,
    "externalAPIs": false,
    "automaticDiscovery": false,
    "executeDatasetContent": false,
    "approval": "explicit-file-manifest",
    "boundedRetries": true
