{
  "manifest_version": 3,
  "name": "NXYZ Mouse Mic",
  "short_name": "NXYZ Mouse",
  "version": "1.0.2",
  "description": "Voice and keyboard click guidance for Palantir Foundry with local targeting and confirmation for high-impact actions.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://*.palantirfoundry.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.palantirfoundry.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NXYZ Mouse Mic",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
