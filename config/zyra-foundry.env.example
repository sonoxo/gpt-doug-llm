# Zyra Foundry MCP/REST profile - secret-free example
# Copy values into your local .env or secret manager. Do not commit secrets.

FOUNDRY_BASE_URL=https://zyra.usw-17.palantirfoundry.com
FOUNDRY_ALLOWED_HOST=zyra.usw-17.palantirfoundry.com
FOUNDRY_SCOPES=api:ontologies-read
FOUNDRY_ENABLE_WRITES=false
FOUNDRY_TIMEOUT_SECONDS=10

# Palantir MCP builder-plane authentication for an external MCP client.
# FOUNDRY_TOKEN=<secure-user-token>

# REST/service application alternative:
# FOUNDRY_CLIENT_ID=<developer-console-client-id>
# FOUNDRY_CLIENT_SECRET=<developer-console-client-secret>

# Ontology MCP runtime-plane URL. Copy the exact value from the
# Developer Console application's MCP page after MCP is enabled.
# FOUNDRY_ONTOLOGY_MCP_URL=<foundry-generated-mcp-url>

# Optional AIP verification target.
# PALANTIR_AIP_ONTOLOGY=<ontology-api-name>
# PALANTIR_AIP_LOGIC_QUERY=<published-query-api-name>
# PALANTIR_AIP_MODEL=<model-rid>
