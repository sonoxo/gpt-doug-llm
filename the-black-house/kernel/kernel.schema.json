{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-house.local/schemas/kernel-v3.json",
  "title": "Black House Kernel Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kernelVersion",
    "controlPlane",
    "missionProtocol",
    "authority",
    "objectTypes",
    "relationshipTypes",
    "invariants",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "kernelVersion": {"const": "3.0.0"},
    "controlPlane": {"const": "THE_BLACK_HOUSE_V1"},
    "missionProtocol": {"const": "black-house-mission-v1"},
    "authority": {"const": "sonoxo/gpt-doug-llm/the-black-house"},
    "objectTypes": {
      "type": "array",
      "minItems": 19,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "relationshipTypes": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "invariants": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": [
        "typedObjectsRequired",
        "registeredRelationshipsOnly",
        "evidenceRequiresProvenance",
        "consequentialMutationRequiresHumanApproval",
        "runtimeHealthRequiredBeforeGreen",
        "unknownActionsFailClosed",
        "externalAuthorizationNeverImplied"
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "repository", "contract"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
