  "platform": "CHROME_MANIFEST_V3",
  "runtimeStatus": "LOCAL_FUNCTIONALITY_VERIFIED",
  "publicationStatus": "NOT_YET_PUBLISHED",
  "missionPurpose": "Manage the authenticated owner's own YouTube subscriptions through official Google APIs with explicit preview and human confirmation before destructive actions.",
  "policy": {
