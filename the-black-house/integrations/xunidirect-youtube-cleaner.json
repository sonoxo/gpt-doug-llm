    "api": "YouTube Data API v3",
    "oauthScope": "https://www.googleapis.com/auth/youtube.force-ssl",
    "mutation": "subscriptions.delete"
  },
  "evidenceContract": [
    "filter_criteria",
    "matched_count",
    "selected_count",
    "human_confirmation",
    "deleted_count",
    "failed_count",
    "quota_state",
    "timestamp"
  ],
  "missionFlow": [
    "MISSION",
    "POLICY",
    "OWNER_AUTH",
    "SELECTION_PREVIEW",
    "HUMAN_APPROVAL",
    "EXECUTION",
    "RESULT",
    "AUDIT_EVIDENCE"
  ]
}
