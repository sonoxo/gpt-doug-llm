#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
LIGHTFORCE="$BIN_DIR/gpt-doug-lightforce"

if [ ! -x "$LIGHTFORCE" ]; then
  LIGHTFORCE="$HOME/.local/bin/gpt-doug-lightforce"
fi

if [ ! -x "$LIGHTFORCE" ]; then
  printf '%s\n' "[GPT-SWARM] Light Force runtime is not installed." >&2
  printf '%s\n' "Install with: curl -fsSL https://raw.githubusercontent.com/sonoxo/gpt-doug-llm/main/scripts/install-lightforce | bash" >&2
  exit 127
fi

case "${1:-live}" in
  live|show|takeover)
    exec "$LIGHTFORCE" live
    ;;
  on|activate|summon)
    exec "$LIGHTFORCE" on
    ;;
  pulse)
    exec "$LIGHTFORCE" pulse
    ;;
  status)
    exec "$LIGHTFORCE" status
    ;;
  off|deactivate|sleep)
    exec "$LIGHTFORCE" off
    ;;
  help|-h|--help)
    cat <<'EOF'
gpt-swarm                 Launch stable 100-HIVE live terminal swarm
gpt-swarm live            Same as default
gpt-swarm pulse           Trigger Light Force pulse
gpt-swarm status          Show swarm state
gpt-swarm off             Disable Light Force state
gpt-swarm on              Enable Light Force state without full-screen view

Controls in live mode:
  p        pulse
  Space    pause/resume
  q / Esc  return terminal
  Ctrl+C   kill switch
EOF
    ;;
  *)
    printf 'usage: gpt-swarm [live|on|pulse|status|off|help]\n' >&2
    exit 2
    ;;
esac
