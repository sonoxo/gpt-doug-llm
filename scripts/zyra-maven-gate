#!/usr/bin/env python3

import base64
import getpass
import hashlib
import json
import os
from pathlib import Path
import urllib.error
import urllib.request
import webbrowser
from datetime import datetime, timezone


ROOT = Path(__file__).resolve().parents[1]
STATE = Path.home() / ".config" / "gpt-doug"

HOST = "zyra.usw-17.palantirfoundry.com"

RID = (
    "ri.artifacts.main.repository."
    "5e094e5c-9968-42f3-ad62-dfb688accb9b"
)

BASE = (
    f"https://{HOST}/artifacts/api/repositories/"
    f"{RID}/contents/release/maven"
)

PALANTIR = (
    f"https://{HOST}/workspace/artifacts/{RID}/publish"
    "?layout=maven&name=gpt-doug-foundry-bridge"
)


def load(name):
    path = STATE / name

    if not path.exists():
        raise SystemExit(
            f"NO-GO: missing proof {path}"
        )

    return json.loads(path.read_text())


def digest(data):
    return hashlib.sha256(data).hexdigest()


def get(url, username, token):
    encoded = base64.b64encode(
        f"{username}:{token}".encode()
    ).decode()

    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Basic {encoded}",
            "Accept": "*/*",
            "User-Agent": "zyra-maven-gate/1",
        },
        method="GET",
    )

    try:
        with urllib.request.urlopen(
            req,
            timeout=30,
        ) as response:
            return response.status, response.read()

    except urllib.error.HTTPError as exc:
        body = exc.read(1000).decode(
            "utf-8",
            errors="replace",
        )

        print(
            f"REMOTE ERROR: HTTP {exc.code}"
        )

        if body:
            print(body)

        raise SystemExit(
            "MAVEN READINESS: NO-GO"
        )


release = load(
    "palantir-maven-release-last.json"
)

consumer = load(
    "palantir-maven-consumer-last.json"
)

binding = load(
    "palantir-maven-binding-last.json"
)

lineage = load(
    "palantir-maven-lineage.json"
)

coord = release["coordinates"]

group, artifact, version = coord.split(
    ":",
    2,
)

expected_pom = release[
    "integrity"
]["pom_sha256"]

expected_jar = release[
    "integrity"
]["jar_sha256"]

path = (
    group.replace(".", "/")
    + "/"
    + artifact
    + "/"
    + version
)

pom_url = (
    f"{BASE}/{path}/"
    f"{artifact}-{version}.pom"
)

jar_url = (
    f"{BASE}/{path}/"
    f"{artifact}-{version}.jar"
)

print()
print("=" * 64)
print(" ZYRA // READ-ONLY FOUNDRY MAVEN GATE")
print("=" * 64)
print("ARTIFACT :", coord)

token = os.getenv(
    "PALANTIR_MAVEN_TOKEN",
    "",
).strip()

username = os.getenv(
    "PALANTIR_MAVEN_USERNAME",
    "",
)

if not token:
    print()
    print("PALANTIR MAVEN:")
    print(PALANTIR)
    print()
    print(
        "Generate a NEW token from Publish -> Maven."
    )

    try:
        webbrowser.open(PALANTIR)
    except Exception:
        pass

    token = getpass.getpass(
        "Foundry Maven token (HIDDEN): "
    ).strip()

if not token:
    raise SystemExit(
        "NO-GO: token missing"
    )

print()
print("=== LIVE EXACT MAVEN READ ===")

pom_status, pom_data = get(
    pom_url,
    username,
    token,
)

jar_status, jar_data = get(
    jar_url,
    username,
    token,
)

pom_sha = digest(pom_data)
jar_sha = digest(jar_data)

# Remove token reference after network operations.
token = ""

print("POM GET    :", pom_status)
print("JAR GET    :", jar_status)
print("POM SHA256 :", pom_sha)
print("JAR SHA256 :", jar_sha)

# Runtime ontology generated by successful GO is preferred.
candidates = [
    (
        "RUNTIME",
        STATE / "maven-ontology-last.json",
    ),
    (
        "REPOSITORY",
        ROOT / "docs/maven-ontology/ontology.json",
    ),
]

ontology = None
ontology_source = None
artifact_node = None

for source, graph_path in candidates:

    if not graph_path.exists():
        continue

    try:
        graph = json.loads(
            graph_path.read_text()
        )
    except Exception:
        continue

    node = next(
        (
            n
            for n in graph.get("nodes", [])
            if n.get(
                "provenance",
                {},
            ).get(
                "exportId"
            )
            ==
            coord
        ),
        None,
    )

    if node:
        ontology = graph
        ontology_source = source
        artifact_node = node
        break

if ontology is None:
    raise SystemExit(
        "NO-GO: current artifact absent from ontology"
    )

nodes = ontology["nodes"]
links = ontology["links"]

ids = {
    n["id"]
    for n in nodes
    if n.get("id")
}

consumer_id = binding[
    "consumer"
]["id"]

uses = [
    consumer_id,
    artifact_node["id"],
    "USES",
]

version_info = next(
    (
        v
        for v in lineage["versions"]
        if v["coordinate"] == coord
    ),
    None,
)

dangling = [
    edge
    for edge in links
    if (
        len(edge) != 3
        or edge[0] not in ids
        or edge[1] not in ids
    )
]

bad_consumed = [
    edge
    for edge in links
    if (
        len(edge) == 3
        and edge[2] == "CONSUMED_BY"
    )
]

current_edges = [
    edge
    for edge in links
    if (
        len(edge) == 3
        and edge[2] == "CURRENT_VERSION"
    )
]

checks = {

    "REMOTE POM GET":
        200 <= pom_status < 300,

    "REMOTE JAR GET":
        200 <= jar_status < 300,

    "POM SHA256":
        pom_sha == expected_pom,

    "JAR SHA256":
        jar_sha == expected_jar,

    "RELEASE PROOF":
        release.get("ok") is True,

    "RELEASE BYTE MATCH":
        (
            release["integrity"]["pom_match"]
            is True
            and
            release["integrity"]["jar_match"]
            is True
        ),

    "MAVEN CONSUMER":
        (
            consumer.get("ok") is True
            and
            consumer["coordinates"] == coord
        ),

    "CONSUMER SHA256":
        consumer[
            "resolution"
        ][
            "jar_match"
        ]
        is True,

    "RUNTIME BINDING":
        (
            binding.get("ok") is True
            and
            binding[
                "dependency"
            ][
                "coordinates"
            ]
            ==
            coord
            and
            binding[
                "dependency"
            ][
                "jarMatch"
            ]
            is True
        ),

    "ONTOLOGY ARTIFACT":
        artifact_node is not None,

    "USES EDGE":
        uses in links,

    "VERSION LINEAGE":
        lineage[
            "latestCoordinate"
        ]
        ==
        coord,

    "OPERATIONAL IMPACT":
        (
            version_info is not None
            and
            version_info.get(
                "operationalImpactCount",
                0,
            )
            >=
            1
            and
            consumer_id
            in
            version_info.get(
                "operationalImpactObjects",
                [],
            )
        ),

    "CURRENT VERSION":
        len(current_edges) == 1,

    "GRAPH INTEGRITY":
        not dangling,

    "SEMANTIC INTEGRITY":
        not bad_consumed,

    "SECRETS NOT STORED":
        (
            release.get(
                "credentials_stored"
            )
            is False
            and
            consumer.get(
                "credentials_stored"
            )
            is False
            and
            binding.get(
                "credentialsStored"
            )
            is False
        ),
}

decision = all(
    checks.values()
)

proof = {
    "schema":
        "xunia.maven-readiness-gate.v1",

    "verifiedAt":
        datetime.now(
            timezone.utc
        ).isoformat(),

    "decision":
        "GO"
        if decision
        else "NO-GO",

    "coordinate":
        coord,

    "ontologySource":
        ontology_source,

    "remotePomSha256":
        pom_sha,

    "remoteJarSha256":
        jar_sha,

    "operationalImpactCount":
        (
            version_info.get(
                "operationalImpactCount",
                0,
            )
            if version_info
            else 0
        ),

    "checks":
        checks,

    "credentialsStored":
        False,
}

STATE.mkdir(
    parents=True,
    exist_ok=True,
)

proof_path = (
    STATE /
    "maven-gate-last.json"
)

proof_path.write_text(
    json.dumps(
        proof,
        indent=2,
        sort_keys=True,
    )
    +
    "\n"
)

proof_path.chmod(
    0o600
)

print()
print("=" * 64)

for name, value in checks.items():
    print(
        f"{name:25} "
        f"{'PASS' if value else 'FAIL'}"
    )

print()
print("ONTOLOGY SOURCE :", ontology_source)
print("IMPACT COUNT    :", proof[
    "operationalImpactCount"
])
print("PROOF           :", proof_path)

print()
print("=" * 64)
print(
    " MAVEN READINESS:",
    "GO" if decision else "NO-GO",
)
print("=" * 64)

if not decision:
    print()
    print("FAILED GATES:")

    for name, value in checks.items():
        if not value:
            print(" -", name)

    raise SystemExit(1)
