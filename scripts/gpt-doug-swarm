#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
SWARM="$BIN_DIR/gpt-swarm"
ACTION="${1:-live}"

if [ ! -x "$SWARM" ]; then
  SWARM="$HOME/.local/bin/gpt-swarm"
fi

maven_visual() {
  if command -v gpt-zyra >/dev/null 2>&1; then
    exec gpt-zyra visual
  fi

  local repo="${GPTDOUG_HOME:-$HOME/.config/gptdoug/src/gpt-doug-llm}"
  if [ -x "$repo/scripts/zyra-maven" ]; then
    exec "$repo/scripts/zyra-maven" visual
  fi

  printf '%s\n' "[GPT-DOUG-SWARM] ZYRA/MAVEN visual launcher not found." >&2
  printf '%s\n' "Expected: gpt-zyra in PATH or $repo/scripts/zyra-maven" >&2
  exit 127
}

shaggoth_console() {
  local repo
  repo="$(CDPATH= cd -- "$BIN_DIR/.." && pwd)"

  if [ ! -f "$repo/pyproject.toml" ] || ! grep -Fq 'name = "gpt-doug-llm"' "$repo/pyproject.toml"; then
    printf '%s\n' "[GPT-DOUG-SWARM] Refusing Shaggoth launch outside gpt-doug-llm." >&2
    exit 126
  fi

  if [ ! -f "$repo/gpt_zyra_shaggoth/cli.py" ]; then
    printf '%s\n' "[GPT-DOUG-SWARM] Hardened GPT-ZYRA-Shaggoth bridge is not installed in this checkout." >&2
    exit 127
  fi

  cd "$repo"
  exec python3 -m gpt_zyra_shaggoth console
}

case "$ACTION" in
  shaggoth|zyra-shaggoth)
    shaggoth_console
    ;;
  maven|zyra|intel)
    maven_visual
    ;;
  help|-h|--help)
    cat <<'EOF'
gpt-doug-swarm              Launch GPT-DOUG 100-HIVE swarm visual
gpt-doug-swarm live         Same as default
gpt-doug-swarm on           Enable swarm state
gpt-doug-swarm pulse        Trigger Light Force pulse
gpt-doug-swarm status       Show swarm state
gpt-doug-swarm off          Disable swarm state
gpt-doug-swarm maven        Open ZYRA / MAVEN visual intelligence console
gpt-doug-swarm zyra         Alias for maven
gpt-doug-swarm intel        Alias for maven
gpt-doug-swarm shaggoth     Open hardened GPT-ZYRA-Shaggoth local Mission Control

MAVEN remains a local, human-controlled intelligence/ontology view.
GPT-ZYRA-Shaggoth remains local-only and read-only by default.
This launcher does not provide access to private military feeds, targeting,
weapon control, or autonomous real-world vehicle tasking.
EOF
    ;;
  *)
    if [ ! -x "$SWARM" ]; then
      printf '%s\n' "[GPT-DOUG-SWARM] gpt-swarm runtime is not installed." >&2
      exit 127
    fi
    exec "$SWARM" "$@"
    ;;
esac
