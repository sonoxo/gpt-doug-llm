#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PROOF="$HOME/.config/gpt-doug/palantir-maven-roundtrip-last.json"
ONTOLOGY="$ROOT/docs/maven-ontology/ontology.json"

usage() {
  cat <<'EOF'
Usage: zyra-maven [status|verify|roundtrip|proof|doctor|ontology|visual]

  status     Show the latest persisted real Maven verification summary
  verify     Perform a real Foundry Maven PUT → GET → SHA-256 round-trip
  roundtrip  Alias for verify
  proof      Print the complete latest persisted non-secret proof JSON
  doctor     Run config/probe + real round-trip + GPT-REDPANDA CPR
  ontology   Validate and summarize the local governed Maven ontology
  visual     Verify Maven, ensure ZYRAPALANTIR LIVE, then open the control-map HUD
EOF
}

summary() {
  if [ ! -f "$PROOF" ]; then
    echo "⚠️ No persisted Maven proof yet. Run: zyra-maven verify"
    return 1
  fi
  python3 - "$PROOF" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
d = json.loads(p.read_text())
pub = d.get("publish", {})
ret = d.get("retrieve", {})
integ = d.get("integrity", {})
print("📦 PALANTIR MAVEN // REAL ROUND-TRIP PROOF")
print(f"🌐 Host ............... {d.get('host','unknown')}")
print(f"📦 Coordinates ........ {d.get('coordinates','unknown')}")
print(f"🕒 Verified ........... {d.get('verified_at','unknown')}")
print(f"⬆️  JAR publish ....... {pub.get('jar_status','?')}")
print(f"⬆️  POM publish ....... {pub.get('pom_status','?')}")
print(f"⬇️  JAR retrieve ...... {ret.get('jar_status','?')}")
print(f"⬇️  POM retrieve ...... {ret.get('pom_status','?')}")
print(f"#️⃣  JAR SHA-256 ....... {integ.get('jar_sha256','unknown')}")
print(f"#️⃣  POM SHA-256 ....... {integ.get('pom_sha256','unknown')}")
print(f"✅ JAR match .......... {integ.get('jar_match') is True}")
print(f"✅ POM match .......... {integ.get('pom_match') is True}")
print(f"🚦 Defense ready ...... {d.get('defense_ready') is True}")
print("🔐 Credentials stored . false")
PY
}

ontology_summary() {
  python3 - "$ONTOLOGY" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
d = json.loads(p.read_text())
nodes = d.get("nodes", [])
links = d.get("links", [])
ids = {n.get("id") for n in nodes if isinstance(n, dict) and n.get("id")}
bad = [x for x in links if not isinstance(x, list) or len(x) < 3 or x[0] not in ids or x[1] not in ids]
if bad:
    raise SystemExit(f"❌ Maven ontology invalid: {len(bad)} broken connector(s)")
meta = d.get("meta", {})
print("🧠 MAVEN CONTROL ONTOLOGY")
print(f"ID ............... {meta.get('id','unknown')}")
print(f"Version .......... {meta.get('version','unknown')}")
print(f"Objects .......... {len(nodes)}")
print(f"Connectors ....... {len(links)}")
print("Validation ....... PASS")
print("Foundry write .... false")
print("External action .. false")
PY
}

cmd="${1:-status}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  status)
    summary
    ;;
  proof)
    if [ ! -f "$PROOF" ]; then
      echo "⚠️ No persisted Maven proof yet. Run: zyra-maven verify" >&2
      exit 1
    fi
    cat "$PROOF"
    ;;
  verify|roundtrip)
    python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py" "$@"
    echo
    summary
    ;;
  doctor)
    echo "🩺 [1/4] Palantir Maven configuration/probe"
    python3 "$ROOT/palantir_maven.py" probe
    echo "📦 [2/4] Real publish → retrieve → SHA-256 round-trip"
    python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py"
    echo "🐼 [3/4] GPT-REDPANDA CPR"
    python3 "$ROOT/redpanda-desktop/palantir_cpr_probe.py"
    echo "🧠 [4/4] Maven ontology"
    ontology_summary
    echo
    summary
    ;;
  ontology)
    ontology_summary
    ;;
  visual)
    echo "📦 Running REAL Foundry Maven verification first..."
    python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py"
    echo "🧠 Validating Maven control ontology..."
    ontology_summary
    echo "📡 Ensuring ZYRAPALANTIR LIVE is running..."
    sh "$ROOT/scripts/zyrapalantir" live-start
    echo "🖥️ Opening visual console with fresh real Maven proof + ontology control map..."
    exec python3 "$ROOT/scripts/zyrapalantir_visual.py" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "❌ Unknown zyra-maven command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
