#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PROOF="$HOME/.config/gpt-doug/palantir-maven-roundtrip-last.json"

usage() {
  cat <<'EOF'
Usage: zyra-maven [status|verify|roundtrip|release|consume|proof|doctor|visual]

  status     Show the latest persisted real Maven verification summary
  verify     Perform a real Foundry Maven PUT → GET → SHA-256 round-trip
  roundtrip  Alias for verify
  release    Publish a real versioned GPT-Doug Maven release
  consume    Resolve latest Foundry release with Apache Maven
  proof      Print the complete latest persisted non-secret proof JSON
  doctor     Run config/probe + real round-trip + GPT-REDPANDA CPR
  visual     Perform a real round-trip, then open the ZYRAPALANTIR visual console
EOF
}

summary() {
  if [ ! -f "$PROOF" ]; then
    echo "⚠️ No persisted Maven proof yet. Run: zyra-maven verify"
    return 1
  fi
  python3 - "$PROOF" <<'PY'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1])
d = json.loads(p.read_text())
pub = d.get("publish", {})
ret = d.get("retrieve", {})
integ = d.get("integrity", {})
print("📦 PALANTIR MAVEN // REAL ROUND-TRIP PROOF")
print(f"🌐 Host ............... {d.get('host','unknown')}")
print(f"📦 Coordinates ........ {d.get('coordinates','unknown')}")
print(f"🕒 Verified ........... {d.get('verified_at','unknown')}")
print(f"⬆️  JAR publish ....... {pub.get('jar_status','?')}")
print(f"⬆️  POM publish ....... {pub.get('pom_status','?')}")
print(f"⬇️  JAR retrieve ...... {ret.get('jar_status','?')}")
print(f"⬇️  POM retrieve ...... {ret.get('pom_status','?')}")
print(f"#️⃣  JAR SHA-256 ....... {integ.get('jar_sha256','unknown')}")
print(f"#️⃣  POM SHA-256 ....... {integ.get('pom_sha256','unknown')}")
print(f"✅ JAR match .......... {integ.get('jar_match') is True}")
print(f"✅ POM match .......... {integ.get('pom_match') is True}")
print(f"🚦 Defense ready ...... {d.get('defense_ready') is True}")
print("🔐 Credentials stored . false")
PY
}

cmd="${1:-status}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  status)
    summary
    ;;
  proof)
    if [ ! -f "$PROOF" ]; then
      echo "⚠️ No persisted Maven proof yet. Run: zyra-maven verify" >&2
      exit 1
    fi
    cat "$PROOF"
    ;;
  verify|roundtrip)
    python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py" "$@"
    echo
    summary
    ;;
  release)
    exec python3 "$ROOT/scripts/zyra-maven-release" "$@"
    ;;
  consume)
    "$ROOT/scripts/zyra-maven-consumer-verify" "$@"
    "$ROOT/scripts/xzoon-sync-from-maven-consumer-proof"
    ;;
  doctor)
    echo "🩺 [1/3] Palantir Maven configuration/probe"
    python3 "$ROOT/palantir_maven.py" probe
    echo "📦 [2/3] Real publish → retrieve → SHA-256 round-trip"
    python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py"
    echo "🐼 [3/3] GPT-REDPANDA CPR"
    python3 "$ROOT/redpanda-desktop/palantir_cpr_probe.py"
    echo
    summary
    ;;
  visual)
    echo "📦 Running REAL Foundry Maven verification first..."
    python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py"
    echo "🖥️ Opening visual console with persisted real Maven proof..."
    exec python3 "$ROOT/scripts/zyrapalantir_visual.py" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "❌ Unknown zyra-maven command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
