#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if [ "${1:-}" = "real" ]; then
  shift
  echo "📦 Running REAL Palantir Maven publish → retrieve → SHA-256 verification..."
  python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py"
  echo "🖥️ Opening ZYRAPALANTIR visual with persisted real Maven proof..."
  exec python3 "$ROOT/scripts/zyrapalantir_visual.py" "$@"
fi

if [ "${1:-}" = "maven-roundtrip" ]; then
  shift
  exec python3 "$ROOT/scripts/palantir_maven_readiness_roundtrip.py" "$@"
fi

if [ "${1:-}" = "visual" ]; then
  shift
  exec python3 "$ROOT/scripts/zyrapalantir_visual.py" "$@"
fi

exec python3 "$ROOT/scripts/zyrapalantir_field.py" "$@"
