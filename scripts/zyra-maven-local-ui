#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
SRC="$ROOT/robotics-intel-site"
DEST="$HOME/.gpt-doug/maven"
PREFERRED_PORT="${MAVEN_LOCAL_PORT:-8787}"
PORTFILE="$DEST/.maven-http.port"
PIDFILE="$DEST/.maven-http.pid"
LOGFILE="$DEST/maven-local.log"
STAMP="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$DEST/backups"

copy_asset() {
  src="$1"
  dst="$2"
  if [ -f "$DEST/$dst" ]; then
    cp "$DEST/$dst" "$DEST/backups/$dst.$STAMP"
  fi
  cp "$SRC/$src" "$DEST/$dst"
}

copy_asset "maven-broadcast.html" "maven-videosarena.html"
copy_asset "maven-ops-sim.html" "maven-ops-sim.html"
copy_asset "maven-rover-ops.html" "maven-rover-ops.html"
copy_asset "rover-registry.json" "rover-registry.json"
copy_asset "rover-connector-contract.json" "rover-connector-contract.json"
for f in   maven-tactical.css   maven-iphone16e.css   maven-camera.css   maven-drone-sim.css   maven-gotham-sim.css   maven-flight-visibility.css   maven-ops-modes.css   maven-tactical.js   maven-iphone16e.js   maven-camera.js   maven-drone-sim.js   maven-gotham-sim.js   maven-ops-modes.js   maven-clean.js   black-ops-nin9.html   black-ops-nin9.css   black-ops-nin9.js   black-ops-nin9-manifest.json
do
  copy_asset "$f" "$f"
done

# MAVEN_OPS_LOCAL_PATCH: keep the local Tactical page current without changing external-action boundaries.
python3 - "$DEST/maven-videosarena.html" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
s = p.read_text(encoding="utf-8")
if "./maven-ops-modes.css" not in s:
    s = s.replace("</head>", '<link rel="stylesheet" href="./maven-ops-modes.css">\n</head>')
if "./maven-ops-modes.js" not in s:
    s = s.replace("</body>", '<script src="./maven-ops-modes.js" defer></script>\n</body>')
p.write_text(s, encoding="utf-8")
PY

cat > "$DEST/index.html" <<'EOF'
<!doctype html>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=./maven-videosarena.html">
<title>GPT-MAVEN LOCAL</title>
<a href="./maven-videosarena.html">Open GPT-MAVEN</a>
EOF

if [ -f "$PIDFILE" ]; then
  oldpid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "$oldpid" ] && kill -0 "$oldpid" 2>/dev/null; then
    kill "$oldpid" 2>/dev/null || true
    i=0
    while kill -0 "$oldpid" 2>/dev/null && [ "$i" -lt 20 ]; do
      sleep 0.1
      i=$((i+1))
    done
  fi
  rm -f "$PIDFILE"
fi

pick_port() {
  python3 - "$PREFERRED_PORT" <<'PY'
import socket, sys
start=int(sys.argv[1])
if not 1024 <= start <= 65515:
    raise SystemExit("invalid MAVEN_LOCAL_PORT")
for port in range(start, min(start+20, 65536)):
    with socket.socket() as s:
        try:
            s.bind(("127.0.0.1", port))
        except OSError:
            continue
        print(port)
        raise SystemExit(0)
raise SystemExit("no free MAVEN local port found")
PY
}

PORT="$(pick_port)"
printf '%s
' "$PORT" > "$PORTFILE"

nohup python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$DEST" >"$LOGFILE" 2>&1 &
pid=$!
printf '%s
' "$pid" > "$PIDFILE"

i=0
while [ "$i" -lt 30 ]; do
  if command -v curl >/dev/null 2>&1 && curl -fsS "http://127.0.0.1:$PORT/maven-videosarena.html" >/dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "MAVEN local server failed. Recent log:" >&2
    tail -n 40 "$LOGFILE" >&2 || true
    exit 1
  fi
  sleep 0.2
  i=$((i+1))
done

URL="http://127.0.0.1:$PORT/maven-videosarena.html?cb=$(date +%s)"
echo "GPT-MAVEN LOCAL: $URL"
echo "BLACK OPS NIN9: http://127.0.0.1:$PORT/black-ops-nin9.html?cb=$(date +%s)"
echo "SOURCE: $SRC"
echo "LOCAL:  $DEST"
echo "PID:    $pid"
echo "PORT:   $PORT"

if [ "${MAVEN_LOCAL_NO_OPEN:-0}" != "1" ] && command -v open >/dev/null 2>&1; then
  open "$URL"
fi
