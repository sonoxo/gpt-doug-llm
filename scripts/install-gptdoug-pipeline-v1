#!/bin/zsh
set -eu

ROOT="${GPT_DOUG_ROOT:-$HOME/gpt-doug-llm}"
BIN="$HOME/.local/bin"
STATE="$HOME/.gpt-doug"
ZSHRC="$HOME/.zshrc"

cd "$ROOT" || exit 1
mkdir -p "$BIN" "$STATE"
touch "$ZSHRC"

python3 -m py_compile tools/gptdoug_boot_classic.py
chmod +x tools/gptdoug_boot_classic.py scripts/gptdoug-pipeline-v1

if [[ -x "$BIN/gptdoug-home" ]]; then
  cp "$BIN/gptdoug-home" "$BIN/gptdoug-home.pre-pipeline-$(date +%Y%m%d-%H%M%S)"
fi

cat > "$BIN/gptdoug-home" <<'SH'
#!/bin/zsh
exec "$HOME/gpt-doug-llm/scripts/gptdoug-pipeline-v1"
SH
chmod +x "$BIN/gptdoug-home"

cat > "$BIN/doug-boot" <<'SH'
#!/bin/zsh
exec python3 "$HOME/gpt-doug-llm/tools/gptdoug_boot_classic.py"
SH
chmod +x "$BIN/doug-boot"

cat > "$BIN/doug-pipeline" <<'SH'
#!/bin/zsh
exec "$HOME/gpt-doug-llm/scripts/gptdoug-pipeline-v1"
SH
chmod +x "$BIN/doug-pipeline"

grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$ZSHRC" ||   echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$ZSHRC"

rm -f "$STATE/STOP"

echo "GPT-DOUG PIPELINE INSTALLED"
echo "  doug-boot      -> boot animation only"
echo "  doug-pipeline  -> boot + self-heal + Dreamwave"
echo "  gptdoug-home   -> permanent pipeline home"
echo
exec "$BIN/doug-pipeline"
