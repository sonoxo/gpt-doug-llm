#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${GPTDOUG_STATE_DIR:-$HOME/.gpt-doug}"
STATE_FILE="${GPTDOUG_LIGHTFORCE_STATE:-$STATE_DIR/lightforce-state.json}"
SWARMS="${GPTDOUG_LIGHTFORCE_SWARMS:-999}"
HIVES="${GPTDOUG_LIGHTFORCE_HIVES:-999}"
ACTION="${1:-on}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_LIVE="$SCRIPT_DIR/../tools/gptdoug_lightforce_live.py"
INSTALLED_LIVE="${GPTDOUG_LIGHTFORCE_LIVE:-$HOME/.local/share/gpt-doug/gptdoug_lightforce_live.py}"

mkdir -p "$STATE_DIR"

rust='\033[38;5;166m'
orange='\033[38;5;208m'
gold='\033[38;5;220m'
sage='\033[38;5;142m'
cream='\033[38;5;230m'
dim='\033[38;5;244m'
reset='\033[0m'

now_epoch() {
  date +%s
}

write_state() {
  local active="$1"
  local phase="$2"
  local ts
  ts="$(now_epoch)"
  cat > "$STATE_FILE" <<EOF
{
  "schema": "xunia/lightforce-terminal-v1",
  "active": $active,
  "phase": "$phase",
  "gpt_doug": "ONLINE",
  "gpt_chaos": "ONLINE",
  "peer_mode": "DOUG_EQUALS_CHAOS",
  "logical_swarms": $SWARMS,
  "logical_hives": $HIVES,
  "hidden_processes_spawned": 0,
  "human_override": true,
  "mode": "REAL_TELEMETRY_ONLY",
  "timestamp_epoch": $ts
}
EOF
  chmod 600 "$STATE_FILE" 2>/dev/null || true
}

banner() {
  printf "%b\n" "${rust}╭────────────────────────────────────────────────────────╮${reset}"
  printf "%b\n" "${orange}│ ✨ GPT-DOUG // SWARM LIGHT FORCE // DARK FALL ONLINE 🍂 │${reset}"
  printf "%b\n" "${gold}│ 🧠 DOUG = ⚡ CHAOS   🐝 ${SWARMS} SWARMS   🍯 ${HIVES} HIVES      │${reset}"
  printf "%b\n" "${sage}│ LOGICAL FEDERATION // HUMAN OVERRIDE // ZERO DAEMONS   │${reset}"
  printf "%b\n" "${rust}╰────────────────────────────────────────────────────────╯${reset}"
}

pulse() {
  if [ "${GPTDOUG_LIGHTFORCE_NO_ANIM:-0}" = "1" ] || [ ! -t 1 ]; then
    printf "%b\n" "${gold}✨ LIGHT FORCE PULSE // 🧠 DOUG ↔ ⚡ CHAOS ↔ 🐝 HIVE // READY${reset}"
    return
  fi
  local frames=(
    "✦      🧠 DOUG      ·      ⚡ CHAOS      ·      🐝 HIVE      ✦"
    "  ✧    🧠 DOUG   ✦  ·   ⚡ CHAOS   ✦  ·   🐝 HIVE    ✧  "
    "    ✨  🧠 DOUG  ⇄  ⚡ CHAOS  ⇄  🐝 HIVE  ✨    "
    "  ✧    🧠 DOUG   ✦  ·   ⚡ CHAOS   ✦  ·   🐝 HIVE    ✧  "
    "✦      🧠 DOUG      ·      ⚡ CHAOS      ·      🐝 HIVE      ✦"
  )
  local i
  for i in 0 1 2 3 4 3 2 1 0; do
    printf "\r%b%-76s%b" "$gold" "${frames[$i]}" "$reset"
    sleep 0.08
  done
  printf "\r%b%-76s%b\n" "$sage" "✨ LIGHT FORCE STABLE // ${SWARMS} logical swarms // ${HIVES} logical hives" "$reset"
}

show_status() {
  if [ -f "$STATE_FILE" ]; then
    cat "$STATE_FILE"
  else
    write_state false "OFF"
    cat "$STATE_FILE"
  fi
}

case "$ACTION" in
  on|activate|summon)
    write_state true "ACTIVE"
    banner
    pulse
    printf "%b\n" "${cream}LIGHTFORCE // ACTIVE // state=${STATE_FILE}${reset}"
    ;;
  pulse)
    write_state true "PULSE"
    pulse
    write_state true "ACTIVE"
    ;;
  live|takeover|show)
    write_state true "LIVE"
    live_tool=""
    if [ -f "$INSTALLED_LIVE" ]; then
      live_tool="$INSTALLED_LIVE"
    elif [ -f "$REPO_LIVE" ]; then
      live_tool="$REPO_LIVE"
    fi
    if [ -z "$live_tool" ]; then
      printf "%b\n" "${dim}LIGHTFORCE // live visualizer missing; reinstall Light Force${reset}" >&2
      exit 3
    fi
    python3 "$live_tool"
    write_state true "ACTIVE"
    ;;
  status)
    show_status
    ;;
  off|deactivate|sleep)
    write_state false "OFF"
    printf "%b\n" "${dim}🌑 LIGHT FORCE // OFF // logical federation preserved, no background processes${reset}"
    ;;
  *)
    printf "usage: gpt-doug-lightforce [on|live|pulse|status|off]\n" >&2
    exit 2
    ;;
esac
