#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="${GPT_DOUG_BIN_DIR:-$HOME/.local/bin}"
LIB_DIR="${GPT_DOUG_LIB_DIR:-$HOME/.local/share/gpt-doug}"
TARGET="$BIN_DIR/gpt-doug-lightforce"
SWARM_TARGET="$BIN_DIR/gpt-swarm"
LIVE_TARGET="$LIB_DIR/gptdoug_lightforce_live.py"
RAW_BASE="https://raw.githubusercontent.com/sonoxo/gpt-doug-llm/main"

mkdir -p "$BIN_DIR" "$LIB_DIR"

fetch() {
  local url="$1"
  local out="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$out"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$out" "$url"
  else
    printf '%s\n' "✨ curl or wget is required." >&2
    exit 1
  fi
}

fetch "$RAW_BASE/scripts/gpt-doug-lightforce" "$TARGET"
fetch "$RAW_BASE/scripts/gpt-swarm" "$SWARM_TARGET"
fetch "$RAW_BASE/tools/gptdoug_lightforce_live.py" "$LIVE_TARGET"

chmod 755 "$TARGET" "$SWARM_TARGET" "$LIVE_TARGET"
printf '%s\n' "[GPTDOUG // LIGHTFORCE] ✨ installed"
printf 'launcher=%s\n' "$TARGET"
printf 'gpt_swarm=%s\n' "$SWARM_TARGET"
printf 'live_visualizer=%s\n' "$LIVE_TARGET"
printf '%s\n' "[GPTDOUG // COMMAND READY] gpt-swarm"
"$TARGET" on
