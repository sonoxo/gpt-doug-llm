#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GUARDRAIL_ONTOLOGY="$ROOT/safety-shield/ontology/universal-galactic-federation-guardrails-v1.json"

if ! command -v python3 >/dev/null 2>&1; then
  echo "GPT-DOUG-MAX: python3 is required" >&2
  exit 1
fi

# Fail closed when the canonical next-gen guardrail ontology is present.
# Set GPT_DOUG_GUARDRAIL_PREFLIGHT=0 only for repository recovery/repair work.
if [[ -f "$GUARDRAIL_ONTOLOGY" && "${GPT_DOUG_GUARDRAIL_PREFLIGHT:-1}" != "0" ]]; then
  if ! PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m agents.galactic_guardrails --root "$ROOT" validate >/dev/null; then
    echo "GPT-DOUG-MAX: GALACTIC GUARDRAIL PREFLIGHT FAILED" >&2
    echo "Run: scripts/doug-max guardrails validate" >&2
    exit 78
  fi
fi

if [[ $# -eq 0 ]]; then
  cd "$ROOT"
  exec env ZYRA_ACTIVE=1 GPT_DOUG_MAX=1 GPT_DOUG_GUARDRAILS=1 python3 "$ROOT/zyra_chat.py"
fi

first_arg_lc="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
case "$first_arg_lc" in
  nedu|gpt-nedu|novice|novice-edu)
    shift
    cd "$ROOT"
    exec python3 -m gpt_nedu "$@"
    ;;
  invention-lab)
    shift
    exec python3 "$ROOT/scripts/invention_lab.py" "$@"
    ;;
  robotics-lab|schematic-lab|patent-robotics)
    shift
    exec python3 "$ROOT/scripts/gpt_doug_max_robotics_lab.py" "$@"
    ;;
  patent-scope|scope)
    shift
    exec python3 "$ROOT/scripts/gpt_doug_max_patent_scope.py" "$@"
    ;;
  patent-wire|patent-fabric)
    shift
    exec python3 "$ROOT/scripts/gpt_doug_max_patent_bridge.py" "$@"
    ;;
  patent-intel|patents)
    shift
    if [[ $# -eq 0 ]]; then set -- summary; fi
    exec python3 "$ROOT/scripts/zyrapalantir_patent_intel.py" "$@"
    ;;
  patent-corpus)
    shift
    exec "$ROOT/scripts/zyra-mss-uspto-reader" "$@"
    ;;
  patent-bulk-memory|bulk-patents)
    shift
    exec python3 "$ROOT/scripts/uspto_bulk_memory.py" "$@"
    ;;
  patent-search)
    shift
    if [[ $# -eq 0 ]]; then
      echo "usage: doug-max patent-search <terms>" >&2
      exit 2
    fi
    exec python3 "$ROOT/scripts/gpt_doug_max_patent_bridge.py" search "$*"
    ;;
  mss)
    shift
    exec python3 "$ROOT/scripts/zyra_mss.py" "$@"
    ;;
esac

goal="$*"
goal_lc="$(printf '%s' "$goal" | tr '[:upper:]' '[:lower:]')"
case "$goal_lc" in
  plan\ *) command="/plan ${goal#* }" ;;
  build\ *) command="/do ${goal#* }" ;;
  do\ *) command="/do ${goal#* }" ;;
  evolve\ *) command="/evolve ${goal#* }" ;;
  *) command="/do $goal" ;;
esac

cd "$ROOT"
printf '%s\n/quit\n' "$command" | env ZYRA_ACTIVE=1 GPT_DOUG_MAX=1 GPT_DOUG_GUARDRAILS=1 python3 "$ROOT/zyra_chat.py"
