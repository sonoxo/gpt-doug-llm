#!/usr/bin/env bash
# XUNIA COSMOS / CL1 / free-only spatial astronomy. No paid service.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
if [[ -x .venv/bin/python3 ]]; then
  PYTHON="$ROOT/.venv/bin/python3"
else
  PYTHON="$(command -v python3)"
fi
if [[ "${1:-}" == "import" ]]; then
  shift
  exec "$PYTHON" scripts/xunia_cosmos_import.py "$@"
fi
if [[ "$#" -gt 2 || ( "$#" -ge 1 && "$1" != "serve" ) ]]; then
  echo "Usage: bash scripts/xunia-cosmos [serve [PORT] | import nasa|gaia --limit N]" >&2
  exit 2
fi
if [[ "$#" -eq 2 ]]; then
  exec "$PYTHON" -u scripts/xunia_cosmos_serve.py "$2"
fi
exec "$PYTHON" -u scripts/xunia_cosmos_serve.py
