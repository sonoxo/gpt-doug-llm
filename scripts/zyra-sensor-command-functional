#!/usr/bin/env python3
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import pathlib
import threading
import webbrowser
from urllib.parse import urlparse

ROOT = pathlib.Path(__file__).resolve().parent.parent
BASE = ROOT / "scripts" / "zyra-sensor-command"

loader = importlib.machinery.SourceFileLoader("zyra_sensor_command_base", str(BASE))
spec = importlib.util.spec_from_loader(loader.name, loader)
if spec is None:
    raise SystemExit("NO-GO: unable to load base sensor command server")
base = importlib.util.module_from_spec(spec)
loader.exec_module(base)

PREVIEW_JS = r"""
(() => {
  const style = document.createElement('style');
  style.textContent = `
    .camera-live{margin-top:12px;border:1px solid var(--line);background:#020a0f;padding:10px;display:none}
    .camera-live.visible{display:block}.camera-live h3{margin:0 0 8px;color:var(--cyan);font-size:10px;letter-spacing:1.4px}
    .camera-live video{width:100%;aspect-ratio:16/9;background:#000;border:1px solid #0c3c49;display:block;object-fit:cover}
    .camera-row{display:flex;gap:7px;margin-top:8px}.camera-row button,.camera-row select{flex:1;padding:8px;background:#06131b;color:var(--text);border:1px solid var(--line);font:inherit;font-size:9px}
    .camera-status{margin-top:8px;font-size:9px;color:#77b7c1;line-height:1.4}.camera-status.good{color:var(--green)}.camera-status.bad{color:var(--red)}
  `;
  document.head.appendChild(style);

  const card = document.querySelector('.selected-card');
  if (!card) return;
  const controls = document.getElementById('demoControls');
  const panel = document.createElement('div');
  panel.className = 'camera-live';
  panel.innerHTML = `
    <h3>LOCAL CAMERA // BROWSER PREVIEW</h3>
    <video id="localPreview" autoplay playsinline muted></video>
    <div class="camera-row"><select id="cameraSelect"><option value="">DEFAULT CAMERA</option></select></div>
    <div class="camera-row"><button id="cameraStart">START LOCAL PREVIEW</button><button id="cameraStop">STOP PREVIEW</button></div>
    <div id="cameraStatus" class="camera-status">Preview is off. Video remains inside this browser tab and is not sent to the ZYRA server.</div>
  `;
  card.insertBefore(panel, controls || null);

  const video = document.getElementById('localPreview');
  const select = document.getElementById('cameraSelect');
  const start = document.getElementById('cameraStart');
  const stop = document.getElementById('cameraStop');
  const status = document.getElementById('cameraStatus');
  let stream = null;
  let lastSensorId = null;

  function selectedSensor() {
    if (!current || !Array.isArray(current.sensors)) return null;
    return current.sensors.find(x => x.id === selectedId) || null;
  }

  function localCamera(sensor) {
    if (!sensor || String(sensor.kind).toLowerCase() !== 'camera') return false;
    const tags = Array.isArray(sensor.tags) ? sensor.tags.map(x => String(x).toLowerCase()) : [];
    return tags.includes('local-camera') ||
      String(sensor.protocol).toLowerCase() === 'local-camera' ||
      ((sensor.host === '127.0.0.1' || sensor.host === 'localhost') && String(sensor.site).toUpperCase() === 'LOCAL');
  }

  function setStatus(message, kind='') {
    status.textContent = message;
    status.className = 'camera-status' + (kind ? ' ' + kind : '');
  }

  function stopPreview(message='Preview stopped.') {
    if (stream) {
      stream.getTracks().forEach(track => track.stop());
      stream = null;
    }
    video.srcObject = null;
    setStatus(message);
  }

  async function refreshDevices() {
    if (!navigator.mediaDevices?.enumerateDevices) return;
    const devices = (await navigator.mediaDevices.enumerateDevices()).filter(d => d.kind === 'videoinput');
    const previous = select.value;
    select.innerHTML = '<option value="">DEFAULT CAMERA</option>';
    devices.forEach((device, index) => {
      const option = document.createElement('option');
      option.value = device.deviceId;
      option.textContent = device.label || `CAMERA ${index + 1}`;
      select.appendChild(option);
    });
    if ([...select.options].some(x => x.value === previous)) select.value = previous;
  }

  async function startPreview() {
    const sensor = selectedSensor();
    if (!localCamera(sensor)) {
      setStatus('Select LAPTOP-CAM-01 first.', 'bad');
      return;
    }
    if (!navigator.mediaDevices?.getUserMedia) {
      setStatus('Browser camera API unavailable. Use a current browser on localhost.', 'bad');
      return;
    }
    stopPreview('Requesting camera permission...');
    try {
      const deviceId = select.value;
      const constraints = {video: deviceId ? {deviceId: {exact: deviceId}} : true, audio: false};
      stream = await navigator.mediaDevices.getUserMedia(constraints);
      video.srcObject = stream;
      await video.play().catch(() => {});
      await refreshDevices();
      stream.getVideoTracks().forEach(track => {
        track.addEventListener('ended', () => stopPreview('Camera stream ended.'));
      });
      const track = stream.getVideoTracks()[0];
      setStatus(`LIVE LOCAL PREVIEW // ${track?.label || 'camera'} // not recorded or uploaded`, 'good');
    } catch (error) {
      setStatus(`CAMERA NO-GO // ${error.name || 'Error'}: ${error.message || error}`, 'bad');
    }
  }

  function syncPanel() {
    const sensor = selectedSensor();
    const show = localCamera(sensor);
    panel.classList.toggle('visible', show);
    if (!show && stream) stopPreview('Preview stopped because the selected node changed.');
    if (sensor?.id !== lastSensorId) {
      lastSensorId = sensor?.id || null;
      if (show) refreshDevices().catch(() => {});
    }
  }

  start.addEventListener('click', startPreview);
  stop.addEventListener('click', () => stopPreview());
  select.addEventListener('change', () => { if (stream) startPreview(); });
  window.addEventListener('pagehide', () => stopPreview());

  const originalRender = render;
  render = function(data) {
    originalRender(data);
    queueMicrotask(syncPanel);
  };
  setInterval(syncPanel, 1000);
  syncPanel();
})();
"""


class FunctionalHandler(base.Handler):
    def _bytes(self, status: int, content_type: str, body: bytes) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/camera-preview.js":
            self._bytes(200, "text/javascript; charset=utf-8", PREVIEW_JS.encode("utf-8"))
            return
        if parsed.path in ("/", "/index.html"):
            source = base.WEB_ROOT.joinpath("index.html").read_text(encoding="utf-8")
            source = source.replace("</body>", '<script src="/camera-preview.js"></script>\n</body>')
            self._bytes(200, "text/html; charset=utf-8", source.encode("utf-8"))
            return
        return super().do_GET()


def parse_args():
    parser = argparse.ArgumentParser(description="Functional ZYRA local sensor command-center HUD")
    parser.add_argument("--mode", choices=("auto", "live", "demo"), default="auto")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--config", default=str(base.DEFAULT_CONFIG))
    parser.add_argument("--snapshot", default=str(base.DEFAULT_SNAPSHOT))
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--timeout", type=float, default=2.0)
    parser.add_argument("--no-open", action="store_true")
    return parser.parse_args()


def main() -> int:
    ns = parse_args()
    if ns.host not in ("127.0.0.1", "localhost", "::1"):
        raise SystemExit("NO-GO: command center is intentionally loopback-only")

    config = pathlib.Path(ns.config).expanduser()
    snapshot = pathlib.Path(ns.snapshot).expanduser()
    mode = ns.mode
    if mode == "auto":
        mode = "live" if config.exists() else "demo"
    if mode == "live" and not config.exists():
        raise SystemExit(f"NO-GO: live mode requires authorized config: {config}")

    state = base.State(mode, config, snapshot, max(0.5, ns.interval), max(0.1, ns.timeout))
    threading.Thread(target=state.run, daemon=True, name="sensor-refresh").start()

    server = base.CommandServer((ns.host, ns.port), FunctionalHandler, state)
    host, port = server.server_address[:2]
    url_host = "127.0.0.1" if host in ("0.0.0.0", "::") else host
    url = f"http://{url_host}:{port}/"

    print("============================================================", flush=True)
    print(" ZYRA // FUNCTIONAL SENSOR COMMAND CENTER", flush=True)
    print("============================================================", flush=True)
    print(f"MODE            : {mode.upper()}", flush=True)
    print(f"URL             : {url}", flush=True)
    print("BIND            : LOOPBACK ONLY", flush=True)
    print("HEALTH TELEMETRY: ACTIVE", flush=True)
    print("CAMERA PREVIEW  : USER-CONTROLLED / BROWSER-LOCAL", flush=True)
    print("SERVER CAPTURE  : DISABLED", flush=True)
    print("RECORDING       : DISABLED", flush=True)
    print("TARGETING       : DISABLED", flush=True)
    print("CTRL-C          : STOP", flush=True)
    print("============================================================", flush=True)

    if not ns.no_open:
        threading.Timer(0.5, lambda: webbrowser.open(url)).start()

    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        pass
    finally:
        state.stop_event.set()
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
