  "mode": "DEFENSIVE_INTELLIGENCE_DEMO_ONLY",
  "objectTypes": [
    "Mission",
    "MissionSystem",
    "Asset",
    "IntelReport",
    "Indicator",
    "SecurityFinding",
    "SoftwareArtifact",
    "AnalystAssessment",
    "DefensiveRecommendation",
    "AuditEvent"
  ],
  "linkTypes": [
    "MissionDependsOnSystem",
    "SystemRunsOnAsset",
    "IntelReportContainsIndicator",
    "IndicatorObservedOnAsset",
    "FindingAffectsAsset",
    "AssetUsesArtifact",
    "AssessmentCorrelatesEvidence",
    "AssessmentProducesRecommendation",
    "RecommendationProtectsMission",
    "AuditEventRecordsDecision"
  ],
  "decisionPolicy": {
    "automaticExternalAction": false,
    "humanReviewRequired": true,
    "syntheticDataOnly": true,
